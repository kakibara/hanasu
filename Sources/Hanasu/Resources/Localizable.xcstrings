        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La chiave API (o l'account di servizio) non è corretta oppure non hai l'autorizzazione per usare l'API Gemini (%@)"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "API 키(또는 서비스 계정)가 올바르지 않거나 Gemini API를 사용할 권한이 없습니다(%@)"
          }
        },
        "pl" : {
          "stringUnit" : {

          }
        }
      }
    },
    "設定 →「一般」→「翻訳する言語」で日本語も選ぶと、英語で話して日本語で入力できます。" : {
      "comment" : "Onboarding.swift:653",
      "extractionState" : "manual",
      "localizations" : {

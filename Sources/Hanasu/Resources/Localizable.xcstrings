    "例: 「です・ます調に統一する」「英単語は半角で書く」「文末に句点を付けない」" : {
      "comment" : "SettingsView.swift:233",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مثال: «استخدم أسلوبًا رسميًا مهذبًا» «اكتب الأرقام بالأرقام الغربية» «لا تضع نقطة في نهاية الجملة»"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "z. B. „Durchgehend Sie-Form verwenden“, „Zahlen als Ziffern schreiben“, „Kein Punkt am Satzende“"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "e.g. “Use a formal tone throughout”, “Write numbers as digits”, “No period at the end of sentences”"

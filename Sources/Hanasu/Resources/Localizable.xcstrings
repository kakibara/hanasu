        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वॉइस इनपुट के परिणाम और मूल ट्रांसक्रिप्ट यहाँ रहते हैं। जिन वाक्यों का सुधार विफल रहा, उन्हें भी मूल टेक्स्ट से फिर से सुधारा जा सकता है।"
          }

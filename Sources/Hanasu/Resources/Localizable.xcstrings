          }
        }
      }
    },
    "発言を右クリックすると、議事録から除いたり、議事録に使う範囲（最初と最後）を決めたりできます。" : {
      "comment" : "MinutesSelectionViews.swift:103",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انقر بزر الماوس الأيمن على قول لاستبعاده من المحضر أو لتحديد النطاق المستخدم في المحضر (البداية والنهاية)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per Rechtsklick auf eine Äußerung kannst du sie aus dem Protokoll ausschließen oder den Bereich für das Protokoll (Anfang und Ende) festlegen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Right-click a remark to exclude it from the minutes or to set the range (start and end) used for the minutes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz clic derecho en una intervención para excluirla del acta o para fijar el rango (inicio y final) que se usa en el acta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",

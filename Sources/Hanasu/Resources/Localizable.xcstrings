    "Vertex AI のリージョン「%@」は使えません（英小文字・数字・ハイフンだけ。例: global、us-central1）" : {
      "comment" : "GeminiClient.swift:22",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن استخدام منطقة Vertex AI «%@» (أحرف إنجليزية صغيرة وأرقام وشرطات فقط. مثال: global، us-central1)"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Vertex AI-Region „%@“ kann nicht verwendet werden (nur Kleinbuchstaben, Ziffern und Bindestriche; z. B. global, us-central1)"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Vertex AI region “%@” can't be used (lowercase letters, digits, and hyphens only; e.g. global, us-central1)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede usar la región de Vertex AI «%@» (solo minúsculas, números y guiones; p. ej.: global, us-central1)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La région Vertex AI « %@ » n’est pas utilisable (lettres minuscules, chiffres et traits d’union uniquement ; par ex. global, us-central1)"

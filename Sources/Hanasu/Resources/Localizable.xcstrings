        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez Hanasu dans Réglages Système → Confidentialité et sécurité → Accessibilité."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सिस्टम सेटिंग्ज़ → गोपनीयता और सुरक्षा → ऐक्सेसिबिलिटी में Hanasu चालू करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktifkan Hanasu di Pengaturan Sistem → Privasi & Keamanan → Aksesibilitas."

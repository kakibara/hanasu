          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esegue WhisperKit (Whisper in versione CoreML) su questo Mac. L'audio non lascia il Mac. Per il giapponese si consiglia small o superiore. Posizione dei modelli: ~/Library/Application Support/Hanasu/Models/whisper"

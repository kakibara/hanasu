    "ブラウザ" : {
      "comment" : "MeetingDetectionSettingsView.swift:20",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المتصفح"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Browser"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Browsers"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",

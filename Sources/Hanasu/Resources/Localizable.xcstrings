          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanasu를 '다운로드' 등에서 바로 열었기 때문에 교체할 수 없습니다. Hanasu.app을 '응용 프로그램' 폴더로 옮긴 후 다시 여세요"
          }
        },
        "pl" : {
          "stringUnit" : {

        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hasil dikte dan teks asli transkripsi disimpan di sini. Kalimat yang gagal dirapikan juga bisa dirapikan ulang dari teks asli."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qui vengono conservati i risultati della dettatura e la trascrizione originale. Le frasi la cui rifinitura non è riuscita si possono rifinire di nuovo dall'originale."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",

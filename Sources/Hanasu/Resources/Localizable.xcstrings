    "%@\n\nリリースのページから zip をダウンロードして、手で入れ替えることもできます。" : {
      "comment" : "AppUpdate.swift:887",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nيمكنك أيضًا تنزيل ملف zip من صفحة الإصدار واستبدال التطبيق يدويًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nDu kannst das ZIP auch von der Release-Seite laden und die App manuell ersetzen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nYou can also download the zip from the release page and replace the app manually."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nTambién puedes descargar el zip desde la página de la versión y reemplazar la app manualmente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nVous pouvez aussi télécharger le zip depuis la page de la version et remplacer l’app manuellement."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nआप रिलीज़ पेज से zip डाउनलोड करके ऐप को ख़ुद भी बदल सकते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nAnda juga dapat mengunduh zip dari halaman rilis dan mengganti aplikasinya secara manual."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nPuoi anche scaricare lo zip dalla pagina della release e sostituire l’app manualmente."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\n릴리스 페이지에서 zip을 다운로드하여 직접 교체할 수도 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nMożesz też pobrać plik zip ze strony wydania i ręcznie zastąpić aplikację."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nVocê também pode baixar o zip na página da versão e substituir o app manualmente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nМожно также скачать zip со страницы выпуска и заменить приложение вручную."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nZip dosyasını sürüm sayfasından indirip uygulamayı elle de değiştirebilirsiniz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nBạn cũng có thể tải tệp zip từ trang phát hành và thay thế thủ công."
          }
        },
        "zh-CN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\n你也可以从发布页面下载 zip，手动替换。"
          }
        },
        "zh-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\n你也可以從發布頁面下載 zip，手動替換。"
          }
        }
      }
    },

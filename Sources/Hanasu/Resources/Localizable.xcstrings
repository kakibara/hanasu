      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُدخل ما تقوله بعد %@. يمكنك أيضًا تغيير اللغة من العرض أسفل الشاشة أثناء التسجيل."

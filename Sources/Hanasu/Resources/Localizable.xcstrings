        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используется при записи встреч для расшифровки голосов собеседников в Meet, Slack huddle, Teams и т. п. (звук, воспроизводимый на Mac)."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toplantı kaydında Meet, Slack huddle, Teams vb. karşı tarafın sesini (Mac’te çalan ses) yazıya dökmek için kullanılır."
          }
        },
        "vi" : {
          "stringUnit" : {

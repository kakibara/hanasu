        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanasu wurde direkt aus einem Ort wie „Downloads“ geöffnet und kann daher nicht ersetzt werden. Bewege Hanasu.app in den Ordner „Programme“ und öffne es erneut"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanasu was opened directly from a location such as Downloads, so it can't be replaced. Move Hanasu.app to the Applications folder, then open it again"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanasu se abrió directamente desde una ubicación como Descargas, así que no se puede reemplazar. Mueve Hanasu.app a la carpeta Aplicaciones y vuelve a abrirla"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanasu a été ouvert directement depuis un emplacement comme Téléchargements : il ne peut pas être remplacé. Déplacez Hanasu.app dans le dossier Applications, puis rouvrez-le"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanasu को सीधे डाउनलोड जैसी जगह से खोला गया है, इसलिए उसे बदला नहीं जा सकता। Hanasu.app को ऐप्लिकेशन फ़ोल्डर में ले जाकर फिर से खोलें"
          }
        },
        "id" : {
          "stringUnit" : {

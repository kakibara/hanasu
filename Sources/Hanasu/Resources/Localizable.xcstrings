            "value" : "सेटिंग्ज़ → “सामान्य” → “माइक्रोफ़ोन”। रिकॉर्डिंग के दौरान स्क्रीन के नीचे डिस्प्ले के माइक्रोफ़ोन बटन से भी बदल सकते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pengaturan → “Umum” → “Mikrofon”. Bisa juga diganti dengan tombol mikrofon di tampilan bawah layar saat merekam."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impostazioni → «Generali» → «Microfono». Puoi cambiarlo anche con il pulsante del microfono nell'indicatore in basso sullo schermo durante la registrazione."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정 → \"일반\" → \"마이크\". 녹음 중 화면 아래 표시의 마이크 버튼으로도 전환할 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ustawienia → „Ogólne” → „Mikrofon”. Można też przełączyć przyciskiem mikrofonu na panelu u dołu ekranu podczas nagrywania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajustes → “Geral” → “Microfone”. Também é possível trocar com o botão do microfone no indicador na parte inferior da tela durante a gravação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Настройки → «Основные» → «Микрофон». Переключить можно и кнопкой микрофона на панели внизу экрана во время записи."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayarlar → “Genel” → “Mikrofon”. Kayıt sırasında ekranın altındaki göstergede mikrofon düğmesiyle de değiştirilebilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cài đặt → “Chung” → “Micrô”. Cũng có thể chuyển bằng nút micrô ở phần hiển thị cuối màn hình khi đang ghi âm."
          }
        },
        "zh-CN" : {
          "stringUnit" : {

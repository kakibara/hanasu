            "state" : "translated",
            "value" : "“शुरू करें” दबाने के बाद, जहाँ इनपुट करना है वहाँ %@ दबाकर बोलकर देखें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setelah menekan “Mulai”, buka tempat Anda ingin mengetik, tekan %@, lalu coba berbicara."
          }
        },
        "it" : {
          "stringUnit" : {

    "書き始めた時刻つきで保存します。入力中に「ここ重要」を押すと、その文を印の説明にします。" : {
      "comment" : "MeetingNotesViews.swift:81",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُحفظ مع وقت بدء الكتابة. إذا ضغطت «مهم» أثناء الكتابة، تصبح تلك الجملة وصفًا للعلامة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird mit der Uhrzeit gespeichert, zu der du zu schreiben begonnen hast. Drückst du beim Schreiben „Wichtig“, wird der Text zur Beschreibung der Markierung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saved with the time you started typing. Press “Important” while typing to make that text the mark's description."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se guarda con la hora en que empezaste a escribir. Si pulsas «Importante» mientras escribes, esa frase será la descripción de la marca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrée avec l’heure à laquelle vous avez commencé à écrire. Appuyez sur « Important » pendant la saisie pour faire de ce texte la description du repère."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लिखना शुरू करने के समय के साथ सहेजा जाता है। लिखते समय “महत्वपूर्ण” दबाने पर वह वाक्य निशान का विवरण बन जाता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catatan disimpan beserta waktu mulai ditulis. Jika Anda menekan “Penting” saat mengetik, kalimat itu menjadi keterangan tanda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viene salvata con l'orario in cui hai iniziato a scrivere. Se premi «Importante» mentre scrivi, quella frase diventa la descrizione del segno."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "쓰기 시작한 시각과 함께 저장합니다. 입력 중에 \"중요\"를 누르면 그 문장을 표시의 설명으로 합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapisywane z czasem rozpoczęcia pisania. Jeśli podczas pisania klikniesz „Ważne”, ten tekst stanie się opisem oznaczenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "É salva com o horário em que você começou a escrever. Se pressionar “Importante” enquanto escreve, essa frase vira a descrição da marca."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохраняется со временем начала ввода. Если во время ввода нажать «Важно», этот текст станет описанием отметки."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yazmaya başladığınız zamanla kaydedilir. Yazarken “Önemli”ye basarsanız bu metin işaretin açıklaması olur."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ghi chú được lưu kèm thời điểm bắt đầu viết. Nếu nhấn “Quan trọng” trong lúc nhập, câu đó sẽ thành phần giải thích cho dấu."
          }
        },
        "zh-CN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "会连同开始书写的时间一起存储。输入时按“重要”，会把这句话作为标记的说明。"
          }
        },
        "zh-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "會連同開始書寫的時間一起儲存。輸入時按「重要」，會把這句話作為標記的說明。"
          }
        }
      }
    },

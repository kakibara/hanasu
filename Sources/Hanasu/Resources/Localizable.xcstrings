    "API キー（またはサービスアカウント）が正しくないか、Gemini API を使う権限がありません（%@）" : {
      "comment" : "GeminiClient.swift:17",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مفتاح API (أو حساب الخدمة) غير صحيح، أو ليس لديك إذن باستخدام Gemini API (%@)"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der API-Schlüssel (oder das Dienstkonto) ist ungültig, oder du bist nicht berechtigt, die Gemini API zu verwenden (%@)"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The API key (or service account) is invalid, or you don't have permission to use the Gemini API (%@)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La clave de API (o la cuenta de servicio) no es correcta o no tienes permiso para usar la API de Gemini (%@)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La clé API (ou le compte de service) est incorrecte, ou vous n’êtes pas autorisé à utiliser l’API Gemini (%@)"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "API की (या सर्विस अकाउंट) गलत है, या आपके पास Gemini API इस्तेमाल करने की अनुमति नहीं है (%@)"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunci API (atau akun layanan) salah, atau Anda tidak memiliki izin untuk menggunakan Gemini API (%@)"

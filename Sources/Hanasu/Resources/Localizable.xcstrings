    "文字起こしか、議事録に使う発言を変えました。作り直すと反映されます。" : {
      "comment" : "MinutesSelectionViews.swift:140",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم تغيير النص المفرّغ أو الأقوال المستخدمة في المحضر. أعد إنشاء المحضر لتطبيق التغيير."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Transkription oder die Äußerungen fürs Protokoll wurden geändert. Erstelle das Protokoll neu, um die Änderung zu übernehmen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The transcription or the remarks used for the minutes have changed. Recreate the minutes to reflect the changes."

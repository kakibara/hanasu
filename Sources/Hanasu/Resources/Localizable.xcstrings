    "システム設定 → プライバシーとセキュリティ → アクセシビリティ で Hanasu をオンにしてください。" : {
      "comment" : "SettingsView.swift:328",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فعّل Hanasu في إعدادات النظام ← الخصوصية والأمن ← تسهيلات الاستخدام."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiviere Hanasu unter Systemeinstellungen → Datenschutz & Sicherheit → Bedienungshilfen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn on Hanasu in System Settings → Privacy & Security → Accessibility."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa Hanasu en Ajustes del Sistema → Privacidad y seguridad → Accesibilidad."

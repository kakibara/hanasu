        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щёлкните реплику правой кнопкой мыши, чтобы исключить её из протокола или задать диапазон для протокола (начало и конец)."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir konuşmaya sağ tıklayarak onu tutanaktan hariç tutabilir veya tutanakta kullanılacak aralığı (başlangıç ve son) belirleyebilirsiniz."
          }

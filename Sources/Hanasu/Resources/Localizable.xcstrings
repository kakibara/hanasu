          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes elegir por separado para el dictado y las reuniones entre Estándar del Mac (predeterminado), Whisper (se ejecuta en el Mac) y Gemini (envía el audio) (Ajustes → «General»)."
          }
        },
        "fr" : {
          "stringUnit" : {

    "どのアプリでも、カーソルのある場所に、話した内容を整えて入力します。" : {
      "comment" : "Onboarding.swift:540",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "في أي تطبيق، يُدخل ما تقوله بعد تنقيحه في موضع المؤشر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Überarbeitet das Gesprochene in jeder App und gibt es an der Cursorposition ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In any app, refines what you say and enters it at the cursor."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En cualquier app, introduce lo que dices, ya pulido, donde esté el cursor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans n’importe quelle app, met en forme ce que vous dites et le saisit à l’emplacement du curseur."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "किसी भी ऐप में, कर्सर की जगह पर आपकी बोली गई बात को सुधारकर दर्ज करता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",

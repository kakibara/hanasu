    "付けてから 10 秒のあいだは、押し間違えた印を取り消せます" : {
      "comment" : "MeetingNotesViews.swift:171",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خلال 10 ثوانٍ من إضافة العلامة، يمكنك التراجع عن علامة أُضيفت بالخطأ"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bis 10 Sekunden nach dem Setzen kannst du eine versehentliche Markierung widerrufen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For 10 seconds after adding a mark, you can undo it if you pressed by mistake"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durante los 10 s siguientes a añadir una marca, puedes deshacerla si fue un error"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pendant 10 secondes après l’ajout d’un repère, vous pouvez l’annuler en cas d’erreur"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "निशान लगाने के 10 सेकंड के भीतर, गलती से लगा निशान हटाया जा सकता है"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dalam 10 detik setelah menandai, tanda yang salah tekan bisa dibatalkan"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per 10 s dopo aver aggiunto un segno, puoi annullarlo se è stato un errore"

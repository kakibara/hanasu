        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ej.: «Usar siempre un registro formal», «Escribir los números con cifras», «No poner punto al final»"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Par ex. « Vouvoyer systématiquement », « Écrire les nombres en chiffres », « Pas de point en fin de phrase »"
          }
        },
        "hi" : {

      }
    },
    "会議の記録で相手の声に必要" : {
      "comment" : "SettingsView.swift:345",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مطلوب لصوت الطرف الآخر في تسجيل الاجتماعات"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für die Stimmen der Gegenseite bei Meeting-Aufnahmen nötig"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Needed for others' voices in meeting recordings"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Necesario para la voz de los demás en la grabación de reuniones"
          }
        },
        "fr" : {
          "stringUnit" : {

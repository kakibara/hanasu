        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mikrofon direkam sebagai “Saya”, dan suara speaker (Meet, Slack huddle, Teams, dll.) sebagai “Lawan bicara”. Dengan speaker, suara lawan bicara juga masuk ke mikrofon, jadi earphone membuat hasilnya lebih akurat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registra il microfono come «Io» e l'audio degli altoparlanti (Meet, huddle di Slack, Teams, ecc.) come «Altri». Con gli altoparlanti la voce degli altri entra anche nel microfono; con le cuffie il risultato è più preciso."
          }
        },
        "ko" : {

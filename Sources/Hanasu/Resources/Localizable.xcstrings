          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "किसी कथन पर राइट-क्लिक करके उसे मिनट्स से बाहर कर सकते हैं या मिनट्स के लिए सीमा (शुरुआत और अंत) तय कर सकते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",

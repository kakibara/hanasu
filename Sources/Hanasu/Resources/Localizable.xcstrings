          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "발언을 오른쪽 클릭하면 회의록에서 제외하거나 회의록에 사용할 범위(처음과 끝)를 정할 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kliknij wypowiedź prawym przyciskiem, aby wykluczyć ją z protokołu lub ustawić zakres używany w protokole (początek i koniec)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {

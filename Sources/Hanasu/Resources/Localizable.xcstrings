          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutaj zachowywane są wyniki dyktowania i oryginalne transkrypcje. Tekst, którego nie udało się zredagować, można zredagować ponownie z oryginału."
          }
        },
        "pt-BR" : {
          "stringUnit" : {

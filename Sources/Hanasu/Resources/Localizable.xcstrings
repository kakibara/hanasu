        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Records your microphone as “Me” and the speaker audio (Meet, Slack huddles, Teams, and so on) as “Others”. With speakers, the other participants' voices also reach your microphone, so headphones give more accurate results."
          }
        },
        "es" : {

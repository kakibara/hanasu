    "追加したアプリと、アプリごとの追加ルールが消えます。元に戻せません。" : {
      "comment" : "AppStylesView.swift:58",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستُحذف التطبيقات المضافة والقواعد الإضافية لكل تطبيق. لا يمكن التراجع عن هذا الإجراء."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hinzugefügte Apps und die zusätzlichen Regeln pro App werden gelöscht. Dies kann nicht widerrufen werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Added apps and per-app additional rules will be deleted. This can't be undone."
          }
        },

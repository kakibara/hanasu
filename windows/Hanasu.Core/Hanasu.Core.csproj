<Project Sdk="Microsoft.NET.Sdk">

  <!-- OS に依存しない部品（プロンプト・Gemini・サービスアカウント・辞書・設定・録音データの変換・状態の管理）。
       音声入力と会議の記録の両方から使う。Mac の上でもテストできるよう net8.0 にする -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Hanasu.Core</RootNamespace>
    <!-- 要件: REQ-COM-060 -->
    <!-- UI の文字列のニュートラルの言語（Properties/Strings.resx）は英語。ほかの言語はサテライトアセンブリ -->
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Hanasu.Core.Tests" />
    <!-- UI の文字列（Properties/Strings.resx から作る Strings）をどこからでも読めるように -->
    <Using Include="Hanasu.Core.Properties" />
  </ItemGroup>

  <!-- 要件: REQ-COM-060 -->
  <!-- ユーザーに見せる文字列（エラー・進み具合・HUD・テンプレートの名前など）。Strings.resx は英語、Strings.<カルチャ>.resx が各言語。
       ビルドのときに Hanasu.Core.Properties.Strings（名前ごとのプロパティ）を作る。訳の出し入れは scripts/i18n-resx.py -->
  <ItemGroup>
    <EmbeddedResource Update="Properties\Strings.resx">
      <StronglyTypedFileName>$(IntermediateOutputPath)Strings.Designer.cs</StronglyTypedFileName>
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>Hanasu.Core.Properties</StronglyTypedNamespace>
      <StronglyTypedClassName>Strings</StronglyTypedClassName>
      <PublicClass>true</PublicClass>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic" Version="13.4.0" />
  </ItemGroup>

  <!-- 要件: REQ-COM-061 -->
  <!-- 設計判断: DEC-COM-160 -->
  <!-- AI へのプロンプトの文面（言語ごとの JSON）。Mac 版と同じファイルを、写さずにそのまま埋め込む（Ai/Prompts.cs が読む）。
       リソース名は Hanasu.Prompts.<言語>.json -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\Sources\Hanasu\Resources\Prompts\*.json" LogicalName="Hanasu.Prompts.%(Filename)%(Extension)" Link="Prompts\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>

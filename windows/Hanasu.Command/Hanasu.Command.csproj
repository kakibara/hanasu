<Project Sdk="Microsoft.NET.Sdk">

  <!-- 利用者向けの hanasu コマンド（配布の zip の cli\hanasu.exe）。中身は Hanasu.Core の Hanasu.Core.Command で、ここは入出力と Windows の部品をつなぐだけ。
       計画は docs/plans/cli-windows.md、作りは docs/design/cli.md の「Windows」。設計判断: DEC-COM-193 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>Hanasu.Command</RootNamespace>
    <AssemblyName>hanasu</AssemblyName>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- 呼ぶたびに起動するので、起動の速さを優先する（圧縮しない。DEC-MTG-123 の Windows の速さ）。
         ReadyToRun は publish のときに -p:PublishReadyToRun=true で付ける（ここに書くと、restore のたびにそのマシンの RID が lock ファイルに入り、CI の locked mode と合わなくなる） -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <!-- 会議を並べて読むと、細かいオブジェクトを大量に作る。Server GC（コアごとのヒープ）で GC の回数を減らす（DEC-MTG-123。
         架空の会議 1,000 件の検索の中身が、手元で 1.1〜1.4 秒から 0.95 秒ほどに縮んだ）。止まる時間より量を優先するので、並行の GC は使わない -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <!-- LibraryImport（P/Invoke のソース生成）に要る -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NeutralLanguage>en</NeutralLanguage>
    <!-- PATH に入れる cli\ に hanasu.exe だけを置く（ほかの DLL を混ぜない。DEC-COM-193）。サテライトの訳も exe に入れる -->
    <SatelliteResourceLanguages>en;ja;zh-Hans;zh-Hant;ko;es;fr;de;it;pt-BR;ru;tr;vi;id;pl;ar;hi</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hanasu.Core\Hanasu.Core.csproj" />
    <ProjectReference Include="..\Hanasu.Platform\Hanasu.Platform.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 画面のロック・スリープを知る（Windows Hello の鍵を捨てる。DEC-COM-144・W3）。コンソールの exe なので、隠れた窓は SystemEvents が作る -->
    <PackageReference Include="Microsoft.Win32.SystemEvents" Version="8.0.0" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <!-- Whisper（whisper.cpp を Whisper.net 経由で使う）による端末上の文字起こし。
       Whisper.net は Windows / macOS / Linux で動くので net8.0 にし、Mac の CLI からも確かめられるようにする -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Hanasu.Whisper</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Hanasu.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hanasu.Core\Hanasu.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
  </ItemGroup>

</Project>

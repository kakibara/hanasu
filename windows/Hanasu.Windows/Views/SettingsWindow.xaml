<Window x:Class="Hanasu.Windows.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="clr-namespace:Hanasu.Windows.Properties"
        xmlns:local="clr-namespace:Hanasu.Windows.Views"
        Title="{x:Static p:Strings.Settings_Title}"
        Width="680" Height="720" MinWidth="560" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        FontFamily="Yu Gothic UI, Meiryo UI, Segoe UI" FontSize="13">
    <Window.Resources>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,14,0,6" />
        </Style>
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>
        <Style x:Key="Error" TargetType="TextBlock" BasedOn="{StaticResource Note}">
            <Setter Property="Foreground" Value="#FFC5221F" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,3" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="MinHeight" Value="26" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Margin" Value="0,3,16,0" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" BorderBrush="#FFE0E0E0" BorderThickness="0,1,0,0" Padding="16,10">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="{x:Static p:Strings.Close}" Click="OnCloseClick" Margin="0" IsCancel="True" />
                <TextBlock x:Name="SaveStatus" Style="{StaticResource Note}" VerticalAlignment="Center" Text="{x:Static p:Strings.Settings_SavedImmediately}" />
            </DockPanel>
        </Border>

        <TabControl Margin="12,12,12,6">
            <!-- 一般 -->
            <TabItem Header="{x:Static p:Strings.Settings_Tab_General}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14,4,14,14">
                        <TextBlock Style="{StaticResource Section}" Text="{x:Static p:Strings.Settings_Shortcuts}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="140" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="{x:Static p:Strings.Settings_Dictation}" VerticalAlignment="Center" />
                            <local:HotKeyBox x:Name="DictationHotKeyBox" AutomationProperties.Name="{x:Static p:Strings.Settings_DictationHotKey_A11y}" Grid.Row="0" Grid.Column="1" Margin="0,2,8,2" />
                            <Button Grid.Row="0" Grid.Column="2" Content="{x:Static p:Strings.Settings_ResetToDefault}" Click="OnResetDictationHotKey" AutomationProperties.Name="{x:Static p:Strings.Settings_DictationHotKeyReset_A11y}" />
                            <TextBlock Grid.Row="1" Text="{x:Static p:Strings.Settings_TranslateAndType}" VerticalAlignment="Center" />
                            <local:HotKeyBox x:Name="TranslateHotKeyBox" AutomationProperties.Name="{x:Static p:Strings.Settings_TranslateHotKey_A11y}" Grid.Row="1" Grid.Column="1" Margin="0,2,8,2" />
                            <Button Grid.Row="1" Grid.Column="2" Content="{x:Static p:Strings.Settings_ResetToDefault}" Click="OnResetTranslateHotKey" AutomationProperties.Name="{x:Static p:Strings.Settings_TranslateHotKeyReset_A11y}" />
                        </Grid>
                        <TextBlock x:Name="HotKeyError" Style="{StaticResource Error}" Visibility="Collapsed" />
                        <TextBlock Style="{StaticResource Note}"
                                   Text="{x:Static p:Strings.Settings_ShortcutsNote}" />

                        <!-- 要件: REQ-DIC-013 -->
                        <TextBlock Style="{StaticResource Section}" Text="{x:Static p:Strings.Settings_TranslationLanguages}" />
                        <!-- 翻訳の言語のチェックボックスは、TranslationLanguages.All からコードで作る（SettingsWindow.BuildTranslationLanguageChecks） -->
                        <WrapPanel x:Name="TranslationLanguagesPanel" Orientation="Horizontal" />
                        <TextBlock Style="{StaticResource Note}"
                                   Text="{x:Static p:Strings.Settings_TranslationNote}" />

                        <TextBlock Style="{StaticResource Section}" Text="{x:Static p:Strings.Settings_RecordingMode}" />
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="ToggleModeRadio" GroupName="RecordingMode" Content="{x:Static p:Strings.Settings_Toggle}" Checked="OnRecordingModeChanged" />
                            <RadioButton x:Name="PushToTalkRadio" GroupName="RecordingMode" Content="{x:Static p:Strings.Settings_PushToTalk}" Checked="OnRecordingModeChanged" />
                        </StackPanel>

                        <TextBlock Style="{StaticResource Section}" Text="{x:Static p:Strings.Settings_Microphone}" />
                        <ComboBox x:Name="MicrophoneCombo" AutomationProperties.Name="{x:Static p:Strings.Settings_Microphone_A11y}" SelectionChanged="OnMicrophoneChanged" HorizontalAlignment="Left" MinWidth="320" />
                        <TextBlock x:Name="MicrophoneNote" Style="{StaticResource Note}" />
                        <Button Content="{x:Static p:Strings.Settings_OpenMicrophonePrivacy}" Click="OnOpenMicrophonePrivacy" HorizontalAlignment="Left" Margin="0,4,0,0"
                                ToolTip="{x:Static p:Strings.Settings_OpenMicrophonePrivacy_Tip}" />

                        <!-- 要件: REQ-DIC-081 -->
                        <TextBlock Style="{StaticResource Section}" Text="{x:Static p:Strings.Settings_NoTarget}" />
                        <TextBlock Style="{StaticResource Note}" Margin="0,0,0,6"
                                   Text="{x:Static p:Strings.Settings_NoTargetNote}" />
                        <RadioButton x:Name="FallbackKeepRadio" GroupName="PasteFallback" Content="{x:Static p:Strings.Settings_Fallback_Keep}" Checked="OnPasteFallbackChanged" />
                        <RadioButton x:Name="FallbackRestoreRadio" GroupName="PasteFallback" Margin="0,4,0,0" Content="{x:Static p:Strings.Settings_Fallback_Restore}" Checked="OnPasteFallbackChanged" />

                        <TextBlock Style="{StaticResource Section}" Text="{x:Static p:Strings.Settings_Other}" />
                        <CheckBox x:Name="PlaySoundsCheck" Content="{x:Static p:Strings.Settings_PlaySounds}" Checked="OnPlaySoundsChanged" Unchecked="OnPlaySoundsChanged" />
                        <!-- 要件: REQ-REL-010, REQ-REL-011 -->
                        <CheckBox x:Name="CheckForUpdatesCheck" Content="{x:Static p:Strings.Settings_CheckForUpdatesOnLaunch}" Margin="0,6,0,0" Checked="OnCheckForUpdatesChanged" Unchecked="OnCheckForUpdatesChanged" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="{x:Static p:Strings.Settings_CheckForUpdatesNow}" Click="OnCheckForUpdatesNow" />
                            <TextBlock x:Name="VersionText" Style="{StaticResource Note}" VerticalAlignment="Center" Margin="8,0,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="{x:Static p:Strings.Settings_OpenLogs}" Click="OnOpenLogs" />
                            <Button Content="{x:Static p:Strings.Settings_OpenSettingsFolder}" Click="OnOpenSettingsFolder" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- AI（文章の処理。音声入力と会議で別々に選ぶ） -->
            <TabItem Header="AI">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14,4,14,14">
                        <!-- 要件: REQ-COM-001 / 設計判断: DEC-COM-020, DEC-COM-173（文字起こし AI を AI タブの先頭に置く） -->
                        <TextBlock Style="{StaticResource Section}" Text="{x:Static p:Strings.Settings_TranscriptionAi}" />
                        <TextBlock FontWeight="SemiBold" Text="{x:Static p:Strings.Settings_TranscriptionAi_Dictation}" />
                        <ComboBox x:Name="EngineCombo" SelectionChanged="OnEngineChanged" HorizontalAlignment="Left" MinWidth="320">
                            <ComboBoxItem Content="{x:Static p:Strings.Settings_Engine_Windows}" Tag="Windows" />
                            <ComboBoxItem Content="{x:Static p:Strings.Settings_Engine_Whisper}" Tag="Whisper" />
                            <ComboBoxItem Content="{x:Static p:Strings.Settings_Engine_Gemini}" Tag="Gemini" />
                        </ComboBox>

                        <!-- Windows 標準 -->
                        <StackPanel x:Name="WindowsEnginePanel" Margin="0,6,0,0">
                            <TextBlock Style="{StaticResource Note}"
                                       Text="{x:Static p:Strings.Settings_Engine_WindowsNote}" />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Content="{x:Static p:Strings.Settings_OpenSpeechSettings}" Click="OnOpenSpeechPrivacy" />
                                <Button Content="{x:Static p:Strings.Settings_OpenLanguageSettings}" Click="OnOpenLanguageSettings" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Gemini -->
                        <StackPanel x:Name="GeminiEnginePanel" Margin="0,6,0,0">
                            <TextBlock Style="{StaticResource Note}" Foreground="#FFB06000"
                                       Text="{x:Static p:Strings.Settings_Engine_GeminiNote}" />
                        </StackPanel>

                        <TextBlock FontWeight="SemiBold" Margin="0,12,0,0" Text="{x:Static p:Strings.Settings_TranscriptionAi_Meeting}" />
                        <ComboBox x:Name="MeetingEngineCombo" SelectionChanged="OnMeetingEngineChanged" HorizontalAlignment="Left" MinWidth="320">
                            <ComboBoxItem Content="{x:Static p:Strings.Settings_MeetingEngine_Whisper}" Tag="Whisper" />
                            <ComboBoxItem Content="{x:Static p:Strings.Settings_Engine_Gemini}" Tag="Gemini" />
                        </ComboBox>
                        <TextBlock x:Name="MeetingEngineNote" Style="{StaticResource Note}" />
                        <TextBlock Style="{StaticResource Note}"
                                   Text="{x:Static p:Strings.Settings_MeetingEngineNote}" />

                        <!-- Whisper（音声入力か会議の記録のどちらかが Whisper のとき） -->
                        <StackPanel x:Name="WhisperEnginePanel" Margin="0,10,0,0">
                            <TextBlock Style="{StaticResource Note}"
                                       Text="{x:Static p:Strings.Settings_Engine_WhisperNote}" />
                            <DockPanel Margin="0,6,0,0">
                                <TextBlock Text="{x:Static p:Strings.Settings_Model}" Width="60" VerticalAlignment="Center" />
                                <ComboBox x:Name="WhisperModelCombo" SelectionChanged="OnWhisperModelChanged" />
                            </DockPanel>
                            <DockPanel Margin="60,6,0,0">
                                <Button x:Name="WhisperDownloadButton" Content="{x:Static p:Strings.Settings_Download}" Click="OnWhisperDownload" />
                                <Button x:Name="WhisperCancelButton" Content="{x:Static p:Strings.Settings_CancelDownload}" Click="OnWhisperCancel" />
                                <Button x:Name="WhisperDeleteButton" Content="{x:Static p:Strings.Delete}" AutomationProperties.Name="{x:Static p:Strings.Settings_WhisperDelete_A11y}" Click="OnWhisperDelete" />
                                <Button Content="{x:Static p:Strings.OpenSaveFolder}" Click="OnOpenModelsFolder" />
                                <TextBlock x:Name="WhisperStatus" VerticalAlignment="Center" TextWrapping="Wrap" />
                            </DockPanel>
                            <ProgressBar x:Name="WhisperProgress" Margin="60,6,0,0" Height="6" Minimum="0" Maximum="1" Visibility="Collapsed" />
                            <TextBlock x:Name="WhisperFolderNote" Style="{StaticResource Note}" Margin="60,4,0,0" />
                        </StackPanel>

                        <!-- Gemini の文字起こしのモデル（音声入力か会議の記録のどちらかが Gemini のとき。整形のモデルとは別。DEC-COM-173） -->
                        <DockPanel x:Name="GeminiTranscriptionModelPanel" Margin="0,10,0,0">
                            <TextBlock Text="{x:Static p:Strings.Settings_GeminiTranscriptionModel}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <ComboBox x:Name="GeminiTranscriptionModelCombo" IsEditable="True" HorizontalAlignment="Left" MinWidth="240"
                                      AutomationProperties.Name="{x:Static p:Strings.Settings_GeminiTranscriptionModel}"
                                      LostFocus="OnGeminiTranscriptionModelChanged" SelectionChanged="OnGeminiTranscriptionModelSelectionChanged" />
                        </DockPanel>

                        <!-- 設計判断: DEC-COM-173（文章の AI の用途は処理の名前で呼ぶ: 音声入力整形・議事録） -->
                        <TextBlock Style="{StaticResource Section}" Text="{x:Static p:Strings.Settings_AiAndModels}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="150" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="{x:Static p:Strings.Settings_Ai_Dictation}" TextWrapping="Wrap" MaxWidth="240" VerticalAlignment="Center" />
                            <ComboBox x:Name="DictationAiCombo" Grid.Row="0" Grid.Column="1" Margin="0,2,8,2" SelectionChanged="OnDictationAiChanged">
                                <ComboBoxItem Content="{x:Static p:Strings.Settings_Ai_Local}" Tag="Local" />
                                <ComboBoxItem Content="Gemini" Tag="Gemini" />
                                <ComboBoxItem Content="Claude" Tag="Claude" />
                            </ComboBox>
                            <Grid Grid.Row="0" Grid.Column="2" Margin="0,2,0,2">
                                <ComboBox x:Name="ModelCombo" IsEditable="True" LostFocus="OnModelChanged" SelectionChanged="OnModelSelectionChanged" />
                                <ComboBox x:Name="ClaudeModelCombo" SelectionChanged="OnClaudeModelChanged" />
                                <ComboBox x:Name="LocalModelCombo" SelectionChanged="OnLocalModelChanged" />
                            </Grid>
                            <TextBlock Grid.Row="1" Text="{x:Static p:Strings.Settings_Ai_Meeting}" TextWrapping="Wrap" MaxWidth="240" VerticalAlignment="Center" />
                            <ComboBox x:Name="MeetingAiCombo" Grid.Row="1" Grid.Column="1" Margin="0,2,8,2" SelectionChanged="OnMeetingAiChanged">
                                <ComboBoxItem Content="{x:Static p:Strings.Settings_Ai_Local}" Tag="Local" />
                                <ComboBoxItem Content="Gemini" Tag="Gemini" />
                                <ComboBoxItem Content="Claude" Tag="Claude" />
                            </ComboBox>
                            <Grid Grid.Row="1" Grid.Column="2" Margin="0,2,0,2">
                                <ComboBox x:Name="MinutesModelCombo" IsEditable="True" LostFocus="OnMinutesModelChanged" SelectionChanged="OnMinutesModelSelectionChanged" />
                                <ComboBox x:Name="ClaudeMinutesModelCombo" SelectionChanged="OnClaudeMinutesModelChanged" />
                                <ComboBox x:Name="LocalMinutesModelCombo" SelectionChanged="OnLocalMinutesModelChanged" />
                            </Grid>
                        </Grid>
                        <TextBlock Style="{StaticResource Note}"
                                   Text="{x:Static p:Strings.Settings_AiNote}" />
                        <TextBlock x:Name="AiCredentialNote" Style="{StaticResource Error}" Visibility="Collapsed" />

                        <!-- 要件: REQ-COM-030 / 設計判断: DEC-COM-062, DEC-COM-066 -->
                        <StackPanel x:Name="LocalLlmPanel" Margin="0,10,0,0" Visibility="Collapsed">
                            <TextBlock Text="{x:Static p:Strings.Settings_LocalModels}" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Note}"
                                       Text="{x:Static p:Strings.Settings_LocalModelsNote}" />
                            <ItemsControl x:Name="LocalModelList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,6,0,2">
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                    <Button Content="{x:Static p:Strings.Settings_Download}" Padding="8,1" Tag="{Binding Id}" Click="OnLocalDownload" Visibility="{Binding DownloadVisibility}" />
                                                    <Button Content="{x:Static p:Strings.Settings_Stop}" Padding="8,1" Tag="{Binding Id}" Click="OnLocalCancel" Visibility="{Binding CancelVisibility}" />
                                                    <Button Content="{x:Static p:Strings.Delete}" Padding="8,1" Tag="{Binding Id}" Click="OnLocalDelete" Visibility="{Binding DeleteVisibility}" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <ProgressBar Height="4" Margin="0,2,0,0" Maximum="1" Value="{Binding Progress}" Visibility="{Binding CancelVisibility}" />
                                            <TextBlock Style="{StaticResource Note}" Text="{Binding Status}" />
                                            <TextBlock Style="{StaticResource Note}" Text="{Binding License}" Foreground="{Binding LicenseBrush}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <CheckBox x:Name="RefineCheck" Margin="0,12,0,0" Content="{x:Static p:Strings.Settings_Refine}" Checked="OnRefineChanged" Unchecked="OnRefineChanged" />
                        <TextBlock Style="{StaticResource Note}" Text="{x:Static p:Strings.Settings_RefineNote}" />
                        <!-- 要件: REQ-DIC-082 整形の出力の言語。整形がオフのときは選べない -->
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="{x:Static p:Strings.Settings_RefineLanguage}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox x:Name="RefineLanguageCombo" SelectionChanged="OnRefineLanguageChanged" MinWidth="160">
                                <ComboBoxItem Content="{x:Static p:Strings.Settings_RefineLanguage_AsSpoken}" Tag="AsSpoken" />
                                <ComboBoxItem Content="{x:Static p:Strings.Settings_RefineLanguage_Japanese}" Tag="Japanese" />
                            </ComboBox>
                        </StackPanel>
                        <CheckBox x:Name="SendAppNameCheck" Margin="0,8,0,0" Content="{x:Static p:Strings.Settings_SendAppName}" Checked="OnSendAppNameChanged" Unchecked="OnSendAppNameChanged" />

                        <TextBlock Style="{StaticResource Section}" Text="{x:Static p:Strings.Settings_GeminiAuth}" />
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="ApiKeyRadio" GroupName="Auth" Content="{x:Static p:Strings.Settings_Auth_ApiKey}" Checked="OnAuthModeChanged" />
                            <RadioButton x:Name="ServiceAccountRadio" GroupName="Auth" Content="{x:Static p:Strings.Settings_Auth_ServiceAccount}" Checked="OnAuthModeChanged" />
                        </StackPanel>

                        <StackPanel x:Name="ApiKeyPanel" Margin="0,8,0,0">
                            <DockPanel>
                                <TextBlock Text="{x:Static p:Strings.Settings_ApiKey}" Width="110" TextWrapping="Wrap" VerticalAlignment="Center" />
                                <Button DockPanel.Dock="Right" Content="{x:Static p:Strings.Delete}" AutomationProperties.Name="{x:Static p:Strings.Settings_GeminiKeyDelete_A11y}" Click="OnDeleteApiKey" Margin="8,0,0,0" />
                                <!-- 設計判断: DEC-COM-143（Claude と同じ「接続を試す」） -->
                                <Button DockPanel.Dock="Right" x:Name="GeminiCheckButton" Content="{x:Static p:Strings.Settings_TestConnection}" AutomationProperties.Name="{x:Static p:Strings.Settings_GeminiCheck_A11y}" Click="OnCheckGemini" Margin="8,0,0,0" />
                                <Button DockPanel.Dock="Right" Content="{x:Static p:Strings.Save}" Click="OnSaveApiKey" Margin="8,0,0,0" />
                                <PasswordBox x:Name="ApiKeyBox" Padding="4,3" />
                            </DockPanel>
                            <TextBlock x:Name="ApiKeyStatus" Style="{StaticResource Note}" Margin="110,3,0,0" />
                            <TextBlock Style="{StaticResource Note}" Margin="110,0,0,0"
                                       Text="{x:Static p:Strings.Settings_TestConnectionNote}" />
                        </StackPanel>

                        <StackPanel x:Name="ServiceAccountPanel" Margin="0,8,0,0">
                            <DockPanel>
                                <TextBlock Text="{x:Static p:Strings.Settings_KeyJson}" Width="110" TextWrapping="Wrap" VerticalAlignment="Center" />
                                <Button DockPanel.Dock="Right" Content="{x:Static p:Strings.Settings_Browse}" Click="OnBrowseServiceAccount" Margin="8,0,0,0" />
                                <TextBox x:Name="ServiceAccountPathBox" Padding="4,3" LostFocus="OnServiceAccountPathChanged" />
                            </DockPanel>
                            <DockPanel Margin="0,6,0,0">
                                <TextBlock Text="{x:Static p:Strings.Settings_Region}" Width="110" TextWrapping="Wrap" VerticalAlignment="Center" />
                                <TextBox x:Name="VertexLocationBox" Width="160" HorizontalAlignment="Left" Padding="4,3" LostFocus="OnVertexLocationChanged" />
                            </DockPanel>
                            <DockPanel Margin="110,6,0,0">
                                <Button x:Name="GeminiCheckServiceAccountButton" DockPanel.Dock="Left" Content="{x:Static p:Strings.Settings_TestConnection}" AutomationProperties.Name="{x:Static p:Strings.Settings_VertexCheck_A11y}" Click="OnCheckGemini" />
                                <TextBlock x:Name="ServiceAccountStatus" Style="{StaticResource Note}" Margin="0" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock Style="{StaticResource Note}" Margin="110,3,0,0"
                                       Text="{x:Static p:Strings.Settings_ServiceAccountNote}" />
                        </StackPanel>

                        <TextBlock Style="{StaticResource Section}" Text="{x:Static p:Strings.Settings_ClaudeApiKey}" />
                        <DockPanel>
                            <TextBlock Text="{x:Static p:Strings.Settings_ApiKey}" Width="110" TextWrapping="Wrap" VerticalAlignment="Center" />
                            <Button DockPanel.Dock="Right" Content="{x:Static p:Strings.Delete}" AutomationProperties.Name="{x:Static p:Strings.Settings_ClaudeKeyDelete_A11y}" Click="OnDeleteClaudeKey" Margin="8,0,0,0" />
                            <Button DockPanel.Dock="Right" x:Name="ClaudeCheckButton" Content="{x:Static p:Strings.Settings_TestConnection}" Click="OnCheckClaude" Margin="8,0,0,0" />
                            <Button DockPanel.Dock="Right" Content="{x:Static p:Strings.Save}" Click="OnSaveClaudeKey" Margin="8,0,0,0" />
                            <PasswordBox x:Name="ClaudeKeyBox" Padding="4,3" />
                        </DockPanel>
                        <TextBlock x:Name="ClaudeKeyStatus" Style="{StaticResource Note}" Margin="110,3,0,0" />
                        <TextBlock Style="{StaticResource Note}" Margin="110,0,0,0"
                                   Text="{x:Static p:Strings.Settings_ClaudeNote}" />

                        <TextBlock Style="{StaticResource Section}" Text="{x:Static p:Strings.Settings_KeyProtection}" />
                        <CheckBox x:Name="HelloCheck" Content="{x:Static p:Strings.Settings_UseHello}" Checked="OnHelloChanged" Unchecked="OnHelloChanged" />
                        <TextBlock x:Name="HelloStatus" Style="{StaticResource Note}" />
                        <TextBlock Style="{StaticResource Note}"
                                   Text="{x:Static p:Strings.Settings_KeyProtectionNote}" />

                        <TextBlock Style="{StaticResource Section}" Text="{x:Static p:Strings.Settings_Trial}" />
                        <TextBox x:Name="TrialInput" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56" Padding="4,3"
                                 Text="{x:Static p:Strings.Settings_TrialSample}" />
                        <!-- 要件: REQ-DIC-013 -->
                        <!-- 「…を試す」の翻訳のボタンは、設定で選んだ翻訳の言語ごとにコードで作り、整形のボタンの後ろに入れる（SettingsWindow.UpdateTranslationControls） -->
                        <WrapPanel x:Name="TrialButtonsPanel" Orientation="Horizontal" Margin="0,6,0,0">
                            <Button x:Name="TrialRefineButton" Content="{x:Static p:Strings.Settings_TryRefine}" Click="OnTrialRefine" Margin="0,0,8,4" />
                            <TextBlock x:Name="TrialStatus" Style="{StaticResource Note}" VerticalAlignment="Center" />
                        </WrapPanel>
                        <!-- 設計判断: DEC-COM-153（ハイコントラストでは OS の色。App.xaml） -->
                        <TextBox x:Name="TrialOutput" IsReadOnly="True" TextWrapping="Wrap" MinHeight="56" Margin="0,6,0,0" Padding="4,3" Style="{StaticResource ReadOnlyOutput}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 会議 -->
            <TabItem Header="{x:Static p:Strings.Settings_Tab_Meetings}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14,4,14,14">
                        <TextBlock Style="{StaticResource Section}" Text="{x:Static p:Strings.Settings_Shortcuts}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="140" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="{x:Static p:Strings.Settings_MeetingStartStop}" VerticalAlignment="Center" />
                            <local:HotKeyBox x:Name="MeetingHotKeyBox" AutomationProperties.Name="{x:Static p:Strings.Settings_MeetingHotKey_A11y}" Grid.Row="0" Grid.Column="1" Margin="0,2,8,2" />
                            <Button Grid.Row="0" Grid.Column="2" Content="{x:Static p:Strings.Settings_ResetToDefault}" Click="OnResetMeetingHotKey" AutomationProperties.Name="{x:Static p:Strings.Settings_MeetingHotKeyReset_A11y}" />
                            <TextBlock Grid.Row="1" Text="{x:Static p:Strings.Settings_HighlightMark}" VerticalAlignment="Center" />
                            <local:HotKeyBox x:Name="HighlightHotKeyBox" AutomationProperties.Name="{x:Static p:Strings.Settings_HighlightHotKey_A11y}" Grid.Row="1" Grid.Column="1" Margin="0,2,8,2" />
                            <Button Grid.Row="1" Grid.Column="2" Content="{x:Static p:Strings.Settings_ResetToDefault}" Click="OnResetHighlightHotKey" AutomationProperties.Name="{x:Static p:Strings.Settings_HighlightHotKeyReset_A11y}" />
                        </Grid>
                        <TextBlock x:Name="MeetingHotKeyError" Style="{StaticResource Error}" Visibility="Collapsed" />
                        <CheckBox x:Name="HighlightHotKeyCheck" Content="{x:Static p:Strings.Settings_UseHighlightHotKey}" Checked="OnHighlightHotKeyEnabledChanged" Unchecked="OnHighlightHotKeyEnabledChanged" />

                        <TextBlock Style="{StaticResource Section}" Text="{x:Static p:Strings.Settings_Speakers}" />
                        <CheckBox x:Name="DiarizeCheck" Content="{x:Static p:Strings.Settings_Diarize}" Checked="OnDiarizeChanged" Unchecked="OnDiarizeChanged" />
                        <TextBlock Style="{StaticResource Note}"
                                   Text="{x:Static p:Strings.Settings_DiarizeNote}" />

                        <TextBlock Style="{StaticResource Section}" Text="{x:Static p:Strings.Settings_Minutes}" />
                        <!-- 要件: REQ-DIC-073 -->
                        <CheckBox x:Name="ApplyDictionaryCheck" Content="{x:Static p:Strings.Settings_ApplyDictionaryToMeetings}" Checked="OnApplyDictionaryChanged" Unchecked="OnApplyDictionaryChanged" />
                        <TextBlock Style="{StaticResource Note}" Text="{x:Static p:Strings.Settings_ApplyDictionaryToMeetingsNote}" />
                        <CheckBox x:Name="MakeMinutesCheck" Content="{x:Static p:Strings.Settings_MakeMinutes}" Checked="OnMakeMinutesChanged" Unchecked="OnMakeMinutesChanged" />
                        <TextBlock x:Name="MinutesAiNote" Style="{StaticResource Note}" />
                        <TextBlock Style="{StaticResource Note}" Text="{x:Static p:Strings.Settings_MinutesNote}" />

                        <TextBlock Style="{StaticResource Section}" Text="{x:Static p:Strings.Settings_Storage}" />
                        <!-- 要件: REQ-MTG-010 -->
                        <!-- 設計判断: DEC-MTG-016, DEC-MTG-139（保存しているキー KeepMeetingAudio の裏返し。次の記録からの既定） -->
                        <CheckBox x:Name="DeleteAudioCheck" Content="{x:Static p:Strings.Settings_DeleteAudioAfterTranscription}" Checked="OnDeleteAudioChanged" Unchecked="OnDeleteAudioChanged" />
                        <TextBlock Style="{StaticResource Note}" Text="{x:Static p:Strings.Settings_DeleteAudioNote}" />
                        <!-- 要件: REQ-MTG-057 -->
                        <!-- 設計判断: DEC-MTG-143 -->
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="{x:Static p:Strings.Settings_AudioRetention}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox x:Name="AudioRetentionCombo" AutomationProperties.Name="{x:Static p:Strings.Settings_AudioRetention}" MinWidth="160" SelectionChanged="OnAudioRetentionChanged" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Note}" Text="{x:Static p:Strings.Settings_AudioRetentionNote}" />
                        <!-- 要件: REQ-MTG-056 -->
                        <DockPanel Margin="0,8,0,0">
                            <Button DockPanel.Dock="Right" Content="{x:Static p:Strings.Meeting_ManageAudio}" Click="OnManageAudio" Margin="8,0,0,0" />
                            <TextBlock x:Name="AudioStatusText" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </DockPanel>
                        <DockPanel Margin="0,8,0,0">
                            <TextBlock Text="{x:Static p:Strings.Settings_SaveLocation}" Width="110" TextWrapping="Wrap" VerticalAlignment="Center" />
                            <Button DockPanel.Dock="Right" Content="{x:Static p:Strings.Settings_Open}" Click="OnOpenMeetingsFolder" Margin="8,0,0,0" />
                            <Button DockPanel.Dock="Right" Content="{x:Static p:Strings.Settings_ResetToDefault}" Click="OnResetMeetingsFolder" AutomationProperties.Name="{x:Static p:Strings.Settings_MeetingsFolderReset_A11y}" Margin="8,0,0,0" />
                            <Button DockPanel.Dock="Right" Content="{x:Static p:Strings.Settings_Browse}" Click="OnBrowseMeetingsFolder" Margin="8,0,0,0" />
                            <TextBox x:Name="MeetingsDirBox" Padding="4,3" IsReadOnly="True" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource Note}" Margin="110,3,0,0" Text="{x:Static p:Strings.Settings_MeetingsFolderNote}" />
                        <TextBlock Style="{StaticResource Note}" Foreground="#FFB06000" Margin="0,10,0,0"
                                   Text="{x:Static p:Strings.Settings_ConsentNote}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 履歴 -->
            <!-- 要件: REQ-DIC-063 -->
            <!-- 設計判断: DEC-DIC-073, DEC-DIC-074 -->
            <TabItem Header="{x:Static p:Strings.Settings_Tab_History}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14,4,14,14">
                        <TextBlock Style="{StaticResource Section}" Text="{x:Static p:Strings.Settings_DictationHistory}" />
                        <CheckBox x:Name="HistoryEnabledCheck" Content="{x:Static p:Strings.Settings_SaveHistory}" Checked="OnHistoryEnabledChanged" Unchecked="OnHistoryEnabledChanged" />
                        <TextBlock Style="{StaticResource Note}"
                                   Text="{x:Static p:Strings.Settings_HistoryNote}" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="{x:Static p:Strings.Settings_KeepDays}" VerticalAlignment="Center" />
                            <ComboBox x:Name="HistoryDaysCombo" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left" MinWidth="160" Margin="0,2"
                                      SelectionChanged="OnHistoryLimitChanged" />
                            <TextBlock Grid.Row="1" Text="{x:Static p:Strings.Settings_KeepCount}" VerticalAlignment="Center" />
                            <ComboBox x:Name="HistoryCountCombo" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left" MinWidth="160" Margin="0,2"
                                      SelectionChanged="OnHistoryLimitChanged" />
                        </Grid>
                        <TextBlock Style="{StaticResource Note}"
                                   Text="{x:Static p:Strings.Settings_KeepNote}" />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="{x:Static p:Strings.Settings_OpenHistory}" Click="OnOpenHistory" />
                            <Button Content="{x:Static p:Strings.OpenSaveFolder}" Click="OnOpenHistoryFolder" />
                            <Button Content="{x:Static p:Strings.Settings_DeleteAllHistory}" Click="OnDeleteAllHistory" />
                        </StackPanel>
                        <TextBlock x:Name="HistoryStatus" Style="{StaticResource Note}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 辞書・ルール -->
            <TabItem Header="{x:Static p:Strings.Settings_Tab_Dictionary}">
                <Grid Margin="14,4,14,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="2*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{StaticResource Section}" Text="{x:Static p:Strings.Settings_UserDictionary}" />
                    <TextBlock Grid.Row="1" Style="{StaticResource Note}" Margin="0,0,0,6"
                               Text="{x:Static p:Strings.Settings_DictionaryHelp}" />
                    <TextBox x:Name="DictionaryBox" Grid.Row="2" AcceptsReturn="True" AcceptsTab="False" VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas, Yu Gothic UI" Padding="4,3" TextChanged="OnDictionaryChanged" />
                    <TextBlock x:Name="DictionaryIssues" Grid.Row="3" Style="{StaticResource Error}" Visibility="Collapsed" />
                    <DockPanel Grid.Row="4" Margin="0,6,0,0">
                        <TextBlock Text="{x:Static p:Strings.Settings_TryReplace}" Width="110" TextWrapping="Wrap" VerticalAlignment="Center" />
                        <TextBox x:Name="DictionaryTrialBox" Padding="4,3" TextChanged="OnDictionaryTrialChanged" />
                    </DockPanel>
                    <TextBlock x:Name="DictionaryTrialResult" Grid.Row="5" Style="{StaticResource Note}" Margin="110,3,0,0" />

                    <TextBlock Grid.Row="6" Style="{StaticResource Section}" Text="{x:Static p:Strings.Settings_ExtraRules}" />
                    <DockPanel Grid.Row="7">
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Note}" Margin="0,0,0,6"
                                   Text="{x:Static p:Strings.Settings_ExtraRulesNote}" />
                        <TextBox x:Name="ExtraInstructionsBox" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Padding="4,3" TextChanged="OnExtraInstructionsChanged" />
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- コマンドと MCP -->
            <!-- 要件: REQ-COM-190, REQ-COM-191, REQ-COM-193 -->
            <!-- 設計判断: DEC-COM-199, DEC-COM-188 -->
            <TabItem Header="{x:Static p:Strings.Settings_Tab_Command}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14,4,14,14">
                        <TextBlock Style="{StaticResource Section}" Text="{x:Static p:Strings.Settings_Cmd_Section}" />
                        <TextBlock x:Name="CommandWarning" Style="{StaticResource Error}" Visibility="Collapsed" />
                        <TextBlock Text="{x:Static p:Strings.Settings_Cmd_Executable}" Margin="0,4,0,2" />
                        <DockPanel>
                            <Button x:Name="CommandCopyExecutable" DockPanel.Dock="Right" Content="{x:Static p:Strings.Settings_Cmd_Copy}" Click="OnCopyCommandText" Tag="executable" />
                            <TextBox x:Name="CommandExecutableBox" IsReadOnly="True" FontFamily="Consolas" Padding="4,3" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource Note}" Text="{x:Static p:Strings.Settings_Cmd_Intro}" />
                        <TextBlock Text="PATH" Margin="0,10,0,2" />
                        <TextBlock x:Name="CommandPathStatus" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button x:Name="CommandPathAddButton" Content="{x:Static p:Strings.Settings_Cmd_PathAdd}" Click="OnCommandPathAdd" />
                            <Button x:Name="CommandPathRemoveButton" Content="{x:Static p:Strings.Settings_Cmd_PathRemove}" Click="OnCommandPathRemove" />
                        </StackPanel>
                        <TextBlock x:Name="CommandPathResult" Style="{StaticResource Note}" />
                        <TextBlock Style="{StaticResource Note}" Text="{x:Static p:Strings.Settings_Cmd_Encoding}" />

                        <TextBlock Style="{StaticResource Section}" Text="MCP" />
                        <TextBlock Style="{StaticResource Note}" Text="{x:Static p:Strings.Settings_Cmd_McpNote}" Margin="0,0,0,6" />
                        <TextBlock Text="Claude Code" Margin="0,4,0,2" />
                        <DockPanel>
                            <Button x:Name="CommandCopyClaudeCode" DockPanel.Dock="Right" Content="{x:Static p:Strings.Settings_Cmd_Copy}" Click="OnCopyCommandText" Tag="claudeCode" />
                            <TextBox x:Name="CommandClaudeCodeBox" IsReadOnly="True" FontFamily="Consolas" Padding="4,3" TextWrapping="Wrap" />
                        </DockPanel>
                        <TextBlock Text="Claude Desktop" Margin="0,10,0,2" />
                        <TextBlock Style="{StaticResource Note}" Text="{x:Static p:Strings.Settings_Cmd_DesktopNote}" Margin="0,0,0,4" />
                        <DockPanel>
                            <Button x:Name="CommandCopyDesktop" DockPanel.Dock="Right" VerticalAlignment="Top" Content="{x:Static p:Strings.Settings_Cmd_Copy}" Click="OnCopyCommandText" Tag="claudeDesktop" />
                            <TextBox x:Name="CommandDesktopBox" IsReadOnly="True" FontFamily="Consolas" Padding="4,3" AcceptsReturn="True" />
                        </DockPanel>

                        <TextBlock Style="{StaticResource Section}" Text="{x:Static p:Strings.Settings_Cmd_AgentSection}" />
                        <TextBlock Style="{StaticResource Note}" Text="{x:Static p:Strings.Settings_Cmd_AgentNote}" Margin="0,0,0,6" />
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="CommandGuideToggle" Content="{x:Static p:Strings.Settings_Cmd_ShowGuide}" Click="OnToggleAgentGuide" />
                            <Button x:Name="CommandCopyGuide" Content="{x:Static p:Strings.Settings_Cmd_Copy}" Click="OnCopyCommandText" Tag="agentGuide" />
                        </StackPanel>
                        <TextBox x:Name="CommandGuideBox" IsReadOnly="True" FontFamily="Consolas" Padding="4,3" Margin="0,6,0,0" AcceptsReturn="True"
                                 TextWrapping="Wrap" MaxHeight="260" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>

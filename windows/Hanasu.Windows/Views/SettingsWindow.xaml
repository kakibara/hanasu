<Window x:Class="Hanasu.Windows.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Hanasu.Windows.Views"
        Title="Hanasu の設定"
        Width="680" Height="720" MinWidth="560" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        FontFamily="Yu Gothic UI, Meiryo UI, Segoe UI" FontSize="13">
    <Window.Resources>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,14,0,6" />
        </Style>
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF5F6368" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>
        <Style x:Key="Error" TargetType="TextBlock" BasedOn="{StaticResource Note}">
            <Setter Property="Foreground" Value="#FFC5221F" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,3" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="MinHeight" Value="26" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Margin" Value="0,3,16,0" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" BorderBrush="#FFE0E0E0" BorderThickness="0,1,0,0" Padding="16,10">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="閉じる" Click="OnCloseClick" Margin="0" IsCancel="True" />
                <TextBlock x:Name="SaveStatus" Style="{StaticResource Note}" VerticalAlignment="Center" Text="変更はすぐに保存されます" />
            </DockPanel>
        </Border>

        <TabControl Margin="12,12,12,6">
            <!-- 一般 -->
            <TabItem Header="一般">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14,4,14,14">
                        <TextBlock Style="{StaticResource Section}" Text="ショートカット" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="音声入力" VerticalAlignment="Center" />
                            <local:HotKeyBox x:Name="DictationHotKeyBox" Grid.Row="0" Grid.Column="1" Margin="0,2,8,2" />
                            <Button Grid.Row="0" Grid.Column="2" Content="既定に戻す" Click="OnResetDictationHotKey" />
                            <TextBlock Grid.Row="1" Text="英訳して入力" VerticalAlignment="Center" />
                            <local:HotKeyBox x:Name="TranslateHotKeyBox" Grid.Row="1" Grid.Column="1" Margin="0,2,8,2" />
                            <Button Grid.Row="1" Grid.Column="2" Content="既定に戻す" Click="OnResetTranslateHotKey" />
                        </Grid>
                        <TextBlock x:Name="HotKeyError" Style="{StaticResource Error}" Visibility="Collapsed" />
                        <TextBlock Style="{StaticResource Note}"
                                   Text="欄をクリックしてから、使いたい組み合わせを押します。録音中は Esc で取り消せます。Alt + Space（ウインドウメニュー）と Win + H（Windows の音声入力）は Windows が使うので避けています。" />

                        <TextBlock Style="{StaticResource Section}" Text="録音のしかた" />
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="ToggleModeRadio" GroupName="RecordingMode" Content="押すたびに開始／停止（トグル）" Checked="OnRecordingModeChanged" />
                            <RadioButton x:Name="PushToTalkRadio" GroupName="RecordingMode" Content="押している間だけ録音" Checked="OnRecordingModeChanged" />
                        </StackPanel>

                        <TextBlock Style="{StaticResource Section}" Text="文字起こしのエンジン" />
                        <ComboBox x:Name="EngineCombo" SelectionChanged="OnEngineChanged" HorizontalAlignment="Left" MinWidth="320">
                            <ComboBoxItem Content="Windows 標準の音声認識（既定）" Tag="Windows" />
                            <ComboBoxItem Content="Whisper（この PC の上で動かす）" Tag="Whisper" />
                            <ComboBoxItem Content="Gemini（音声を Google に送る）" Tag="Gemini" />
                        </ComboBox>

                        <!-- Windows 標準 -->
                        <StackPanel x:Name="WindowsEnginePanel" Margin="0,6,0,0">
                            <TextBlock Style="{StaticResource Note}"
                                       Text="Windows の音声認識（ディクテーション）で日本語を認識し、話している間に途中経過を出します。Microsoft のオンライン音声認識を使うため、Windows の設定 → プライバシーとセキュリティ → 音声認識 で「オンライン音声認識」をオンにしてください。マイクは Windows の既定のマイクを使います（下の選択は使いません）。" />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Content="音声認識の設定を開く" Click="OnOpenSpeechPrivacy" />
                                <Button Content="言語の設定を開く" Click="OnOpenLanguageSettings" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Whisper -->
                        <StackPanel x:Name="WhisperEnginePanel" Margin="0,6,0,0">
                            <TextBlock Style="{StaticResource Note}"
                                       Text="whisper.cpp でこの PC の上で文字起こしします（音声は外に出ません）。録音を止めてからまとめて文字起こしします。モデルを選ぶと Hugging Face からダウンロードします。大きいモデルほど精度は上がりますが、遅くなります。" />
                            <DockPanel Margin="0,6,0,0">
                                <TextBlock Text="モデル" Width="60" VerticalAlignment="Center" />
                                <ComboBox x:Name="WhisperModelCombo" SelectionChanged="OnWhisperModelChanged" />
                            </DockPanel>
                            <DockPanel Margin="60,6,0,0">
                                <Button x:Name="WhisperDownloadButton" Content="ダウンロード" Click="OnWhisperDownload" />
                                <Button x:Name="WhisperCancelButton" Content="取り消し" Click="OnWhisperCancel" />
                                <Button x:Name="WhisperDeleteButton" Content="削除" Click="OnWhisperDelete" />
                                <Button Content="保存先を開く" Click="OnOpenModelsFolder" />
                                <TextBlock x:Name="WhisperStatus" VerticalAlignment="Center" TextWrapping="Wrap" />
                            </DockPanel>
                            <ProgressBar x:Name="WhisperProgress" Margin="60,6,0,0" Height="6" Minimum="0" Maximum="1" Visibility="Collapsed" />
                            <TextBlock x:Name="WhisperFolderNote" Style="{StaticResource Note}" Margin="60,4,0,0" />
                        </StackPanel>

                        <!-- Gemini -->
                        <StackPanel x:Name="GeminiEnginePanel" Margin="0,6,0,0">
                            <TextBlock Style="{StaticResource Note}" Foreground="#FFB06000"
                                       Text="録音した音声を Google の Gemini API（AI タブで設定した Gemini の認証と、音声入力の Gemini のモデル）に送って文字起こしします。音声が Google に送られることに注意してください。録音を止めてからまとめて送ります（1 回 7 分まで）。" />
                        </StackPanel>

                        <TextBlock Style="{StaticResource Section}" Text="マイク" />
                        <ComboBox x:Name="MicrophoneCombo" SelectionChanged="OnMicrophoneChanged" HorizontalAlignment="Left" MinWidth="320" />
                        <TextBlock x:Name="MicrophoneNote" Style="{StaticResource Note}" />

                        <TextBlock Style="{StaticResource Section}" Text="そのほか" />
                        <CheckBox x:Name="PlaySoundsCheck" Content="録音の開始・停止で音を鳴らす" Checked="OnPlaySoundsChanged" Unchecked="OnPlaySoundsChanged" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="ログのフォルダを開く" Click="OnOpenLogs" />
                            <Button Content="設定のフォルダを開く" Click="OnOpenSettingsFolder" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- AI（文章の処理。音声入力と会議で別々に選ぶ） -->
            <TabItem Header="AI">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14,4,14,14">
                        <TextBlock Style="{StaticResource Section}" Text="使う AI とモデル" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="音声入力（整形・英訳）" VerticalAlignment="Center" />
                            <ComboBox x:Name="DictationAiCombo" Grid.Row="0" Grid.Column="1" Margin="0,2,8,2" SelectionChanged="OnDictationAiChanged">
                                <ComboBoxItem Content="Gemini" Tag="Gemini" />
                                <ComboBoxItem Content="Claude" Tag="Claude" />
                            </ComboBox>
                            <Grid Grid.Row="0" Grid.Column="2" Margin="0,2,0,2">
                                <ComboBox x:Name="ModelCombo" IsEditable="True" LostFocus="OnModelChanged" SelectionChanged="OnModelSelectionChanged" />
                                <ComboBox x:Name="ClaudeModelCombo" SelectionChanged="OnClaudeModelChanged" />
                            </Grid>
                            <TextBlock Grid.Row="1" Text="会議（議事録）" VerticalAlignment="Center" />
                            <ComboBox x:Name="MeetingAiCombo" Grid.Row="1" Grid.Column="1" Margin="0,2,8,2" SelectionChanged="OnMeetingAiChanged">
                                <ComboBoxItem Content="Gemini" Tag="Gemini" />
                                <ComboBoxItem Content="Claude" Tag="Claude" />
                            </ComboBox>
                            <Grid Grid.Row="1" Grid.Column="2" Margin="0,2,0,2">
                                <ComboBox x:Name="MinutesModelCombo" IsEditable="True" LostFocus="OnMinutesModelChanged" SelectionChanged="OnMinutesModelSelectionChanged" />
                                <ComboBox x:Name="ClaudeMinutesModelCombo" SelectionChanged="OnClaudeMinutesModelChanged" />
                            </Grid>
                        </Grid>
                        <TextBlock Style="{StaticResource Note}"
                                   Text="音声入力と会議で、AI とモデルを別々に選べます。Gemini は gemini-3.5-flash-lite（音声入力）と gemini-3.8-flash（議事録）、Claude は Haiku 5.5（音声入力）と Sonnet 5.5（議事録）が既定です。Claude は文章の処理だけに使い、音声の文字起こしには使いません（文字起こしのエンジンは「一般」・「会議」タブ）。" />
                        <TextBlock x:Name="AiCredentialNote" Style="{StaticResource Error}" Visibility="Collapsed" />

                        <CheckBox x:Name="RefineCheck" Margin="0,12,0,0" Content="AI で整形する（誤変換・フィラー・言い直し・句読点を直す）" Checked="OnRefineChanged" Unchecked="OnRefineChanged" />
                        <TextBlock Style="{StaticResource Note}" Text="オフにすると、認識結果に辞書の置き換えだけを当てて入力します。英訳は AI でしかできないので、オフでも AI に送ります。" />
                        <CheckBox x:Name="SendAppNameCheck" Margin="0,8,0,0" Content="入力先のアプリ名を AI に伝える（体裁の参考にする）" Checked="OnSendAppNameChanged" Unchecked="OnSendAppNameChanged" />

                        <TextBlock Style="{StaticResource Section}" Text="Gemini の認証" />
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="ApiKeyRadio" GroupName="Auth" Content="API キー（Google AI Studio）" Checked="OnAuthModeChanged" />
                            <RadioButton x:Name="ServiceAccountRadio" GroupName="Auth" Content="サービスアカウント（Vertex AI）" Checked="OnAuthModeChanged" />
                        </StackPanel>

                        <StackPanel x:Name="ApiKeyPanel" Margin="0,8,0,0">
                            <DockPanel>
                                <TextBlock Text="API キー" Width="110" VerticalAlignment="Center" />
                                <Button DockPanel.Dock="Right" Content="削除" Click="OnDeleteApiKey" Margin="8,0,0,0" />
                                <Button DockPanel.Dock="Right" Content="保存" Click="OnSaveApiKey" Margin="8,0,0,0" />
                                <PasswordBox x:Name="ApiKeyBox" Padding="4,3" />
                            </DockPanel>
                            <TextBlock x:Name="ApiKeyStatus" Style="{StaticResource Note}" Margin="110,3,0,0" />
                        </StackPanel>

                        <StackPanel x:Name="ServiceAccountPanel" Margin="0,8,0,0">
                            <DockPanel>
                                <TextBlock Text="鍵（JSON）" Width="110" VerticalAlignment="Center" />
                                <Button DockPanel.Dock="Right" Content="参照…" Click="OnBrowseServiceAccount" Margin="8,0,0,0" />
                                <TextBox x:Name="ServiceAccountPathBox" Padding="4,3" LostFocus="OnServiceAccountPathChanged" />
                            </DockPanel>
                            <DockPanel Margin="0,6,0,0">
                                <TextBlock Text="リージョン" Width="110" VerticalAlignment="Center" />
                                <TextBox x:Name="VertexLocationBox" Width="160" HorizontalAlignment="Left" Padding="4,3" LostFocus="OnVertexLocationChanged" />
                            </DockPanel>
                            <TextBlock Style="{StaticResource Note}" Margin="110,3,0,0"
                                       Text="Vertex AI ユーザー（roles/aiplatform.user）の権限があるサービスアカウントの鍵を選びます。鍵のファイルの場所だけを保存します（中身は写しません）。鍵のファイルはほかの人が読めない場所に置いてください。リージョンは global が既定です。" />
                        </StackPanel>

                        <TextBlock Style="{StaticResource Section}" Text="Claude の API キー" />
                        <DockPanel>
                            <TextBlock Text="API キー" Width="110" VerticalAlignment="Center" />
                            <Button DockPanel.Dock="Right" Content="削除" Click="OnDeleteClaudeKey" Margin="8,0,0,0" />
                            <Button DockPanel.Dock="Right" x:Name="ClaudeCheckButton" Content="接続を試す" Click="OnCheckClaude" Margin="8,0,0,0" />
                            <Button DockPanel.Dock="Right" Content="保存" Click="OnSaveClaudeKey" Margin="8,0,0,0" />
                            <PasswordBox x:Name="ClaudeKeyBox" Padding="4,3" />
                        </DockPanel>
                        <TextBlock x:Name="ClaudeKeyStatus" Style="{StaticResource Note}" Margin="110,3,0,0" />
                        <TextBlock Style="{StaticResource Note}" Margin="110,0,0,0"
                                   Text="Claude Console（platform.claude.com）で作った API キーを入れます。保存したキーは画面に出しません（末尾 4 文字だけ）。「接続を試す」はモデルの情報を取るだけで、料金はかかりません。" />

                        <TextBlock Style="{StaticResource Section}" Text="API キーの保護" />
                        <CheckBox x:Name="HelloCheck" Content="API キーを Windows Hello で守る（使うときに PIN・顔・指紋で確認する）" Checked="OnHelloChanged" Unchecked="OnHelloChanged" />
                        <TextBlock x:Name="HelloStatus" Style="{StaticResource Note}" />
                        <TextBlock Style="{StaticResource Note}"
                                   Text="キーは %LOCALAPPDATA%\Hanasu\secrets.json に暗号化して置き、settings.json には入れません。既定の DPAPI は、この Windows ユーザーでしか読めませんが、同じユーザーで動くほかのアプリは確認なしに読めます。Windows Hello にすると、ほかのアプリが読もうとしても Windows Hello の確認が出ます（確認は起動してから最初に使うとき 1 回で、画面をロックするとまた求めます）。Hanasu が動いている間に同じユーザーのアプリがメモリを読むことまでは防げません。" />

                        <TextBlock Style="{StaticResource Section}" Text="試す（音声入力の AI）" />
                        <TextBox x:Name="TrialInput" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56" Padding="4,3"
                                 Text="えーと明日の会議なんですけど あの 資料はジェミニで作ったやつを使います" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button x:Name="TrialRefineButton" Content="整形を試す" Click="OnTrialRefine" />
                            <Button x:Name="TrialTranslateButton" Content="英訳を試す" Click="OnTrialTranslate" />
                            <TextBlock x:Name="TrialStatus" Style="{StaticResource Note}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBox x:Name="TrialOutput" IsReadOnly="True" TextWrapping="Wrap" MinHeight="56" Margin="0,6,0,0" Padding="4,3" Background="#FFF7F7F7" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 会議 -->
            <TabItem Header="会議">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14,4,14,14">
                        <TextBlock Style="{StaticResource Section}" Text="ショートカット" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="記録の開始／停止" VerticalAlignment="Center" />
                            <local:HotKeyBox x:Name="MeetingHotKeyBox" Grid.Row="0" Grid.Column="1" Margin="0,2,8,2" />
                            <Button Grid.Row="0" Grid.Column="2" Content="既定に戻す" Click="OnResetMeetingHotKey" />
                            <TextBlock Grid.Row="1" Text="「ここ重要」の印" VerticalAlignment="Center" />
                            <local:HotKeyBox x:Name="HighlightHotKeyBox" Grid.Row="1" Grid.Column="1" Margin="0,2,8,2" />
                            <Button Grid.Row="1" Grid.Column="2" Content="既定に戻す" Click="OnResetHighlightHotKey" />
                        </Grid>
                        <TextBlock x:Name="MeetingHotKeyError" Style="{StaticResource Error}" Visibility="Collapsed" />
                        <CheckBox x:Name="HighlightHotKeyCheck" Content="「ここ重要」のショートカットを使う（記録中だけ有効になります）" Checked="OnHighlightHotKeyEnabledChanged" Unchecked="OnHighlightHotKeyEnabledChanged" />

                        <TextBlock Style="{StaticResource Section}" Text="文字起こし" />
                        <ComboBox x:Name="MeetingEngineCombo" SelectionChanged="OnMeetingEngineChanged" HorizontalAlignment="Left" MinWidth="320">
                            <ComboBoxItem Content="Whisper（この PC の上で動かす。既定）" Tag="Whisper" />
                            <ComboBoxItem Content="Gemini（音声を Google に送る）" Tag="Gemini" />
                        </ComboBox>
                        <TextBlock x:Name="MeetingEngineNote" Style="{StaticResource Note}" />
                        <TextBlock Style="{StaticResource Note}"
                                   Text="記録中は音声をファイルに書くだけにして、記録を止めたあとに「自分」「相手」のチャンネルごとに時刻つきで文字起こしします。Windows 標準の音声認識は、Windows の既定のマイクからしか聞けず PC の音（相手）を渡せないため、会議では選べません。" />

                        <TextBlock Style="{StaticResource Section}" Text="話者" />
                        <CheckBox x:Name="DiarizeCheck" Content="相手側の話者を分ける（話者1・話者2…）" Checked="OnDiarizeChanged" Unchecked="OnDiarizeChanged" />
                        <TextBlock Style="{StaticResource Note}"
                                   Text="sherpa-onnx（pyannote と 3D-Speaker のモデル）でこの PC の上で分けます。初めて使うときにモデル（約 34 MB）をダウンロードします。オフにすると、相手側は「相手」1 人にまとめます。話者名は会議ノートで付け替えられます。" />

                        <TextBlock Style="{StaticResource Section}" Text="議事録" />
                        <CheckBox x:Name="MakeMinutesCheck" Content="記録のあとに AI で議事録を作る" Checked="OnMakeMinutesChanged" Unchecked="OnMakeMinutesChanged" />
                        <TextBlock x:Name="MinutesAiNote" Style="{StaticResource Note}" />
                        <TextBlock Style="{StaticResource Note}" Text="議事録の AI とモデルは「AI」タブの「会議（議事録）」で選びます。文字起こしのテキストだけを送ります（文字起こしのエンジンが Gemini のときは、音声も Google に送ります）。議事録の型は会議ノートで選びます。" />

                        <TextBlock Style="{StaticResource Section}" Text="保存" />
                        <CheckBox x:Name="KeepAudioCheck" Content="処理のあとも音声ファイル（me.wav / others.wav）を残す" Checked="OnKeepAudioChanged" Unchecked="OnKeepAudioChanged" />
                        <TextBlock Style="{StaticResource Note}" Text="オフにすると、文字起こしと議事録のあとで音声を消します（文字起こしに失敗したときは残します）。16 kHz・モノラルの WAV で、1 時間あたり 1 チャンネル約 115 MB です。" />
                        <DockPanel Margin="0,8,0,0">
                            <TextBlock Text="保存先" Width="110" VerticalAlignment="Center" />
                            <Button DockPanel.Dock="Right" Content="開く" Click="OnOpenMeetingsFolder" Margin="8,0,0,0" />
                            <Button DockPanel.Dock="Right" Content="既定に戻す" Click="OnResetMeetingsFolder" Margin="8,0,0,0" />
                            <Button DockPanel.Dock="Right" Content="参照…" Click="OnBrowseMeetingsFolder" Margin="8,0,0,0" />
                            <TextBox x:Name="MeetingsDirBox" Padding="4,3" IsReadOnly="True" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource Note}" Margin="110,3,0,0" Text="会議ごとに「日時」のフォルダを作り、meeting.json（Mac 版と同じ形）・transcript.md・minutes.md・notes.md と音声を置きます。" />
                        <TextBlock Style="{StaticResource Note}" Foreground="#FFB06000" Margin="0,10,0,0"
                                   Text="録音するときは、相手の同意を得てください。イヤホンを使うと、相手の声がマイクに回り込みにくくなります。" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 辞書・ルール -->
            <TabItem Header="辞書・ルール">
                <Grid Margin="14,4,14,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="2*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{StaticResource Section}" Text="ユーザー辞書" />
                    <TextBlock Grid.Row="1" Style="{StaticResource Note}" Margin="0,0,0,6">
                        1 行に 1 つ。語だけ書くと、AI にその表記を伝えます。「読み =&gt; 表記」と書くと、認識結果のその読みを表記に置き換えます（例: ストックマーク =&gt; Stockmark、左は「,」で区切って複数書ける）。「#」で始まる行はメモです。
                    </TextBlock>
                    <TextBox x:Name="DictionaryBox" Grid.Row="2" AcceptsReturn="True" AcceptsTab="False" VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas, Yu Gothic UI" Padding="4,3" TextChanged="OnDictionaryChanged" />
                    <TextBlock x:Name="DictionaryIssues" Grid.Row="3" Style="{StaticResource Error}" Visibility="Collapsed" />
                    <DockPanel Grid.Row="4" Margin="0,6,0,0">
                        <TextBlock Text="置き換えを試す" Width="110" VerticalAlignment="Center" />
                        <TextBox x:Name="DictionaryTrialBox" Padding="4,3" TextChanged="OnDictionaryTrialChanged" />
                    </DockPanel>
                    <TextBlock x:Name="DictionaryTrialResult" Grid.Row="5" Style="{StaticResource Note}" Margin="110,3,0,0" />

                    <TextBlock Grid.Row="6" Style="{StaticResource Section}" Text="追加の整形ルール" />
                    <DockPanel Grid.Row="7">
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Note}" Margin="0,0,0,6"
                                   Text="整形のときに AI（Gemini・Claude）に渡すルール（例: です・ます調に統一）。英訳では使いません。" />
                        <TextBox x:Name="ExtraInstructionsBox" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Padding="4,3" TextChanged="OnExtraInstructionsChanged" />
                    </DockPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>

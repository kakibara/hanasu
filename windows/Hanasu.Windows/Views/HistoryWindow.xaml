<Window x:Class="Hanasu.Windows.Views.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="音声入力の履歴 — Hanasu"
        Width="900" Height="620" MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        FontFamily="Yu Gothic UI, Meiryo UI, Segoe UI" FontSize="13">
    <Window.Resources>
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>
        <Style x:Key="Error" TargetType="TextBlock" BasedOn="{StaticResource Note}">
            <Setter Property="Foreground" Value="#FFC5221F" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,10,0,3" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="MinHeight" Value="26" />
        </Style>
        <Style x:Key="Reader" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontSize" Value="13.5" />
        </Style>
    </Window.Resources>

    <!-- 要件: REQ-DIC-060 -->
    <!-- 設計判断: DEC-DIC-079, DEC-DIC-131 -->
    <DockPanel Margin="12">
        <!-- 上: 検索と絞り込み -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton x:Name="AllRadio" GroupName="Filter" Content="すべて" IsChecked="True" Margin="12,0,10,0" Checked="OnFilterChanged" />
                <RadioButton x:Name="UnrefinedRadio" GroupName="Filter" Content="失敗・未整形" Checked="OnFilterChanged" />
            </StackPanel>
            <TextBlock Text="検索" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox x:Name="SearchBox" AutomationProperties.Name="履歴を検索" Padding="4,3" TextChanged="OnSearchChanged"
                     ToolTip="結果・原文・入力先のアプリから探します。空白で区切ると、すべての語を含むものを出します" />
        </DockPanel>

        <!-- 下: 件数・保存先・すべて削除 -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Button DockPanel.Dock="Right" Content="閉じる" Click="OnCloseClick" Margin="0" IsCancel="True" />
            <Button DockPanel.Dock="Right" Content="すべて削除…" Click="OnDeleteAllClick" />
            <Button DockPanel.Dock="Right" Content="保存先を開く" Click="OnOpenFolderClick" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="CountText" Style="{StaticResource Note}" Margin="0" />
                <TextBlock x:Name="ErrorText" Style="{StaticResource Error}" Visibility="Collapsed" />
            </StackPanel>
        </DockPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" MinWidth="240" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左: 日ごとの一覧 -->
            <ListBox x:Name="EntryList" AutomationProperties.Name="履歴の一覧" Grid.Column="0" SelectionMode="Extended" SelectionChanged="OnSelectionChanged"
                     KeyDown="OnListKeyDown" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizingWhenGrouping="True">
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#FF5F6368" Margin="4,8,0,2" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListBox.GroupStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="2,3">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="{Binding Time}" Foreground="#FF5F6368" Margin="0,0,8,0" />
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Mark}" Foreground="#FFB06000" Margin="6,0,0,0" />
                                <TextBlock Text="{Binding Summary}" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                            <TextBlock Text="{Binding Meta}" FontSize="11" Foreground="#FF80868B" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="結果をコピー" Click="OnCopyOutputClick" />
                        <MenuItem Header="原文をコピー" Click="OnCopyRawClick" />
                        <Separator />
                        <MenuItem Header="削除" Click="OnDeleteClick" />
                    </ContextMenu>
                </ListBox.ContextMenu>
            </ListBox>

            <!-- 一覧が空のとき（0 件・検索に一致しない）の案内 -->
            <TextBlock x:Name="EmptyText" Grid.Column="0" Style="{StaticResource Note}" Margin="12" TextWrapping="Wrap"
                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                       IsHitTestVisible="False" Visibility="Collapsed" />

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- 右: 選んだ項目 -->
            <Grid Grid.Column="2" x:Name="DetailPanel">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="2*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="DetailInfo" Grid.Row="0" Style="{StaticResource Note}" Margin="0" />
                <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="結果（入力した文章）" />
                <TextBox x:Name="OutputBox" AutomationProperties.Name="結果" Grid.Row="2" Style="{StaticResource Reader}" />
                <TextBlock Grid.Row="3" Style="{StaticResource Label}" Text="原文（文字起こし）" />
                <TextBox x:Name="RawBox" AutomationProperties.Name="原文" Grid.Row="4" Style="{StaticResource Reader}" />
                <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button x:Name="CopyOutputButton" Content="結果をコピー" Click="OnCopyOutputClick" />
                    <Button x:Name="CopyRawButton" Content="原文をコピー" Click="OnCopyRawClick" />
                    <Button x:Name="DeleteButton" Content="削除" Click="OnDeleteClick" />
                    <TextBlock x:Name="CopyStatus" Style="{StaticResource Note}" VerticalAlignment="Center" Margin="6,0,0,0" />
                </StackPanel>
            </Grid>
        </Grid>
    </DockPanel>
</Window>

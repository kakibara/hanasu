<Window x:Class="Hanasu.Windows.Views.MeetingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="clr-namespace:Hanasu.Windows.Properties"
        Title="{x:Static p:Strings.Meeting_Title}"
        Width="1040" Height="720" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        FontFamily="Yu Gothic UI, Meiryo UI, Segoe UI" FontSize="13">
    <Window.Resources>
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,8,0,2" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="MinHeight" Value="26" />
        </Style>
        <Style x:Key="Reader" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="FontSize" Value="13.5" />
        </Style>
        <!-- 文字起こしの上の帯の小さいボタン（範囲の解除・話者を戻す・オフレコの解除） -->
        <Style x:Key="ChipButton" TargetType="Button">
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="MinHeight" Value="22" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左: 記録中の表示・会議の一覧・記録の開始 -->
        <!-- 設計判断: DEC-COM-153（固定色の面はハイコントラストで OS の色に差し替える。App.xaml） -->
        <Border Grid.Column="0" Style="{StaticResource SidePane}" BorderThickness="0,0,1,0">
            <DockPanel Margin="10">
                <Border x:Name="LiveBox" DockPanel.Dock="Top" Style="{StaticResource LivePane}" CornerRadius="6" Padding="10,8" Margin="0,0,0,8" Visibility="Collapsed">
                    <StackPanel>
                        <DockPanel>
                            <Button x:Name="StopButton" DockPanel.Dock="Right" Content="{x:Static p:Strings.Meeting_Stop}" Margin="0" Click="OnStopClick" />
                            <TextBlock x:Name="LiveTitle" Style="{StaticResource LiveTitle}" FontWeight="SemiBold" VerticalAlignment="Center" Text="{x:Static p:Strings.Meeting_Recording}" />
                        </DockPanel>
                        <TextBlock x:Name="LiveElapsed" FontSize="22" FontFamily="Consolas, Segoe UI" Margin="0,4,0,0" Text="00:00" />
                        <TextBlock x:Name="LiveProgress" Style="{StaticResource Note}" />
                        <!-- 要件: REQ-MTG-010 -->
                        <!-- 設計判断: DEC-MTG-139（記録中の会議の値だけを変える。既定の設定は変えない。処理に入ったあとは押せない） -->
                        <CheckBox x:Name="LiveDeleteAudioCheck" Margin="0,6,0,0" Visibility="Collapsed" Click="OnLiveDeleteAudioClick">
                            <TextBlock Text="{x:Static p:Strings.Meeting_LiveDeleteAudio}" TextWrapping="Wrap" />
                        </CheckBox>
                    </StackPanel>
                </Border>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <TextBlock Style="{StaticResource Label}" Text="{x:Static p:Strings.Meeting_MicLabel}" />
                    <ComboBox x:Name="MicCombo" SelectionChanged="OnMicChanged" />
                    <TextBlock Style="{StaticResource Label}" Text="{x:Static p:Strings.Meeting_OutputLabel}" />
                    <ComboBox x:Name="OutputCombo" SelectionChanged="OnOutputChanged" />
                    <TextBlock Style="{StaticResource Label}" Text="{x:Static p:Strings.Meeting_TemplateLabel}" />
                    <ComboBox x:Name="NextTemplateCombo" SelectionChanged="OnNextTemplateChanged" />
                    <TextBox x:Name="CustomPromptBox" Margin="0,4,0,0" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" MaxHeight="120"
                             VerticalScrollBarVisibility="Auto" Padding="4,3" Visibility="Collapsed" LostFocus="OnCustomPromptChanged" />
                    <!-- 要件: REQ-MTG-010 -->
                    <!-- 設計判断: DEC-MTG-139（次の記録からの既定。設定画面と同じ値。記録中・処理中は変えられない） -->
                    <CheckBox x:Name="DeleteAudioDefaultCheck" Margin="0,8,0,0" ToolTip="{x:Static p:Strings.Meeting_DeleteAudioDefault_Tip}"
                              Checked="OnDeleteAudioDefaultChanged" Unchecked="OnDeleteAudioDefaultChanged">
                        <TextBlock Text="{x:Static p:Strings.Settings_DeleteAudioAfterTranscription}" TextWrapping="Wrap" />
                    </CheckBox>
                    <Button x:Name="StartButton" Margin="0,10,0,0" Padding="10,6" Content="{x:Static p:Strings.Meeting_Start}" Click="OnStartClick" />
                    <TextBlock x:Name="StartNote" Style="{StaticResource Note}" />
                </StackPanel>

                <Grid>
                <!-- 要件: REQ-MTG-028 -->
                <ListBox x:Name="MeetingList" AutomationProperties.Name="{x:Static p:Strings.Meeting_List_A11y}" SelectionChanged="OnMeetingSelected" BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" KeyDown="OnMeetingListKeyDown">
                    <ListBox.ContextMenu>
                        <ContextMenu Opened="OnMeetingListMenuOpened">
                            <!-- 要件: REQ-MTG-055, REQ-MTG-056 -->
                            <MenuItem x:Name="DeleteAudioMenuItem" Header="{x:Static p:Strings.Meeting_DeleteAudio}" Click="OnDeleteAudioClick" ToolTipService.ShowOnDisabled="True" />
                            <MenuItem Header="{x:Static p:Strings.Meeting_ManageAudio}" Click="OnManageAudioClick" />
                            <Separator />
                            <MenuItem x:Name="DeleteMenuItem" Header="{x:Static p:Strings.Meeting_MoveToRecycleBin}" Click="OnDeleteClick" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2,4">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Detail}" FontSize="11.5" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <!-- 設計判断: DEC-MTG-073 -->
                <!-- 一覧が空のとき（読み込み中・まだ 0 件）の案内。履歴の EmptyText と同じ作り -->
                <TextBlock x:Name="ListEmptyText" Style="{StaticResource Note}" Margin="12" TextAlignment="Center"
                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                           Text="{x:Static p:Strings.Meeting_ListLoading}" />
                </Grid>
            </DockPanel>
        </Border>

        <!-- 右: 選んだ会議 -->
        <TextBlock x:Name="EmptyText" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                   Text="{x:Static p:Strings.Meeting_Empty}" TextWrapping="Wrap" Margin="24" />
        <DockPanel x:Name="DetailPanel" Grid.Column="1" Margin="14,10,14,10" Visibility="Collapsed">
            <StackPanel DockPanel.Dock="Top">
                <!-- 要件: REQ-MTG-029 -->
                <!-- 設計判断: DEC-MTG-024 -->
                <!-- 書き換えられると見てわかるように、いつも枠と鉛筆の印を出す（マウスを載せる・編集中は、標準の見た目で枠の色が変わる） -->
                <Grid>
                    <TextBox x:Name="TitleBox" AutomationProperties.Name="{x:Static p:Strings.Meeting_Title_A11y}" FontSize="18" FontWeight="SemiBold" BorderThickness="1" BorderBrush="#FFBDBDBD"
                             Padding="4,3,32,3" LostFocus="OnTitleChanged" KeyDown="OnTitleKeyDown"
                             ToolTip="{x:Static p:Strings.Meeting_TitleEdit_Tip}" />
                    <TextBlock Text="&#xE70F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" IsHitTestVisible="False" />
                </Grid>
                <TextBlock x:Name="MeetingInfo" Style="{StaticResource Note}" />
                <WrapPanel x:Name="ActionsPanel" Margin="0,8,0,0">
                    <Button x:Name="RegenerateButton" Content="{x:Static p:Strings.Meeting_Regenerate}" Click="OnRegenerateClick" />
                    <!-- 要件: REQ-MTG-128 -->
                    <!-- 設計判断: DEC-MTG-158（出すかは Show で MeetingRecovery.CanRecover から決める） -->
                    <Button x:Name="RecoverButton" Content="{x:Static p:Strings.Meeting_RecoverFromAudio}" ToolTip="{x:Static p:Strings.Meeting_RecoverFromAudio_Tip}"
                            Click="OnRecoverClick" Visibility="Collapsed" />
                    <!-- 要件: REQ-DIC-072, REQ-DIC-074 -->
                    <Button x:Name="DictionaryButton" Content="{x:Static p:Strings.Meeting_Dictionary}" Click="OnDictionaryClick" />
                    <TextBlock Text="{x:Static p:Strings.Meeting_TemplateShort}" VerticalAlignment="Center" Margin="4,0,4,0" />
                    <ComboBox x:Name="TemplateCombo" MinWidth="110" Margin="0,0,6,0" SelectionChanged="OnTemplateChanged" />
                    <Button x:Name="CopyButton" Content="{x:Static p:Strings.Meeting_CopyMarkdown}" Click="OnCopyClick" />
                    <Button Content="{x:Static p:Strings.Meeting_OpenInExplorer}" Click="OnOpenFolderClick" />
                    <!-- 要件: REQ-MTG-055 -->
                    <Button x:Name="DeleteAudioButton" Content="{x:Static p:Strings.Meeting_DeleteAudio}" Click="OnDeleteAudioClick" ToolTipService.ShowOnDisabled="True" />
                    <!-- 要件: REQ-MTG-028 -->
                    <Button x:Name="DeleteButton" Content="{x:Static p:Strings.Meeting_MoveToRecycleBin}" Click="OnDeleteClick" />
                </WrapPanel>
                <TextBlock x:Name="ErrorText" Style="{StaticResource Note}" Foreground="#FFC5221F" Visibility="Collapsed" />
                <TextBlock x:Name="ActionStatus" Style="{StaticResource Note}" />
                <TextBlock Style="{StaticResource Label}" Text="{x:Static p:Strings.Meeting_SpeakersLabel}" x:Name="SpeakersLabel" />
                <WrapPanel x:Name="SpeakersPanel" />
            </StackPanel>

            <!-- 記録中: メモと「ここ重要」 -->
            <Border x:Name="RecordingPanel" DockPanel.Dock="Top" Margin="0,10,0,0" Padding="10" Style="{StaticResource InnerPane}" CornerRadius="6" Visibility="Collapsed">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Static p:Strings.Meeting_Me}" Margin="0,0,6,0" VerticalAlignment="Center" FontSize="12" />
                        <ProgressBar x:Name="MicLevel" AutomationProperties.Name="{x:Static p:Strings.Meeting_MicLevel_A11y}" Grid.Column="1" Height="6" Maximum="0.3" />
                        <TextBlock Grid.Column="2" Text="{x:Static p:Strings.Meeting_Others}" Margin="12,0,6,0" VerticalAlignment="Center" FontSize="12" />
                        <ProgressBar x:Name="OutputLevel" AutomationProperties.Name="{x:Static p:Strings.Meeting_OutputLevel_A11y}" Grid.Column="3" Height="6" Maximum="0.3" />
                    </Grid>
                    <TextBlock x:Name="RecordingNote" Style="{StaticResource Note}" />
                    <DockPanel Margin="0,8,0,0">
                        <!-- 要件: REQ-MTG-012 -->
                        <!-- 設計判断: DEC-MTG-047 -->
                        <!-- 要件: REQ-MTG-046 -->
                        <!-- 設計判断: DEC-MTG-094, DEC-MTG-112 -->
                        <Button DockPanel.Dock="Right" x:Name="OffRecordButton" Content="{x:Static p:Strings.Meeting_OffRecord}" Margin="6,0,0,0" Click="OnOffRecordClick"
                                ToolTip="{x:Static p:Strings.Meeting_OffRecord_Tip}" />
                        <Button DockPanel.Dock="Right" x:Name="UndoHighlightButton" Margin="6,0,0,0" Click="OnUndoHighlightClick" Visibility="Collapsed"
                                ToolTip="{x:Static p:Strings.Meeting_UndoHighlight_Tip}" />
                        <Button DockPanel.Dock="Right" x:Name="HighlightButton" Content="{x:Static p:Strings.Meeting_Highlight}" Margin="6,0,0,0" Click="OnHighlightClick" />
                        <Button DockPanel.Dock="Right" Content="{x:Static p:Strings.Meeting_AddNote}" Margin="6,0,0,0" Click="OnAddNoteClick" />
                        <TextBox x:Name="NoteInput" AutomationProperties.Name="{x:Static p:Strings.Meeting_NoteInput_A11y}" Padding="4,3" KeyDown="OnNoteInputKeyDown" TextChanged="OnNoteInputChanged" />
                    </DockPanel>
                    <!-- 要件: REQ-MTG-046 -->
                    <TextBlock x:Name="OffRecordStatus" Style="{StaticResource LiveTitle}" FontWeight="SemiBold" Margin="0,6,0,0" Visibility="Collapsed" />
                    <TextBlock Style="{StaticResource Note}" Text="{x:Static p:Strings.Meeting_NoteHint}" />
                    <TextBlock x:Name="LiveNotes" Margin="0,6,0,0" TextWrapping="Wrap" FontFamily="Consolas, Yu Gothic UI" />
                </StackPanel>
            </Border>

            <TabControl x:Name="Tabs" Margin="0,10,0,0">
                <TabItem Header="{x:Static p:Strings.Meeting_Tab_Minutes}">
                    <DockPanel>
                        <!-- 設計判断: DEC-MTG-092 -->
                        <Border x:Name="MinutesOutdatedPanel" DockPanel.Dock="Top" Style="{StaticResource InnerPane}" CornerRadius="4" Padding="8,6" Margin="0,6,0,0" Visibility="Collapsed">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" x:Name="MinutesOutdatedRegenerateButton" Content="{x:Static p:Strings.Meeting_Regenerate}" Margin="6,0,0,0" Click="OnRegenerateClick" />
                                <TextBlock Text="{x:Static p:Strings.Meeting_TranscriptOrSelectionChanged}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                        <TextBox x:Name="MinutesBox" AutomationProperties.Name="{x:Static p:Strings.Meeting_Minutes_A11y}" Style="{StaticResource Reader}" />
                    </DockPanel>
                </TabItem>
                <!-- 要件: REQ-MTG-044, REQ-MTG-045, REQ-MTG-046 -->
                <!-- 設計判断: DEC-MTG-091, DEC-MTG-112 -->
                <!-- 発言ごとの一覧（時刻・話者・本文・議事録に使うかのチェックボックス）。上の帯に、使う発言の数・範囲・除いた話者・オフレコの区間 -->
                <TabItem Header="{x:Static p:Strings.Meeting_Tab_Transcript}">
                    <DockPanel>
                        <Border x:Name="SelectionBar" DockPanel.Dock="Top" Style="{StaticResource InnerPane}" CornerRadius="4" Padding="8,6" Margin="0,6,0,4" Visibility="Collapsed">
                            <StackPanel>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" x:Name="ResetSelectionButton" Style="{StaticResource ChipButton}" Content="{x:Static p:Strings.Meeting_Selection_ResetAll}" Click="OnResetSelectionClick" />
                                    <TextBlock x:Name="UsedCountText" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </DockPanel>
                                <WrapPanel x:Name="SelectionChips" Margin="0,2,0,0" />
                                <DockPanel x:Name="TranscriptOutdatedPanel" Margin="0,6,0,0" Visibility="Collapsed">
                                    <Button DockPanel.Dock="Right" x:Name="TranscriptOutdatedRegenerateButton" Content="{x:Static p:Strings.Meeting_Regenerate}" Margin="6,0,0,0" Click="OnRegenerateClick" />
                                    <TextBlock Text="{x:Static p:Strings.Meeting_TranscriptOrSelectionChanged}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBlock x:Name="SelectionHint" Style="{StaticResource Note}" Text="{x:Static p:Strings.Meeting_Selection_Hint}" />
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="TranscriptEmptyText" DockPanel.Dock="Top" Style="{StaticResource Note}" Margin="10,8" FontSize="13.5" Visibility="Collapsed" />
                        <ListBox x:Name="TranscriptList" AutomationProperties.Name="{x:Static p:Strings.Meeting_Transcript_A11y}" SelectionMode="Extended" BorderThickness="0"
                                 HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel">
                            <ListBox.CommandBindings>
                                <CommandBinding Command="ApplicationCommands.Copy" Executed="OnCopyRowsExecuted" CanExecute="OnCopyRowsCanExecute" />
                            </ListBox.CommandBindings>
                            <ListBox.ContextMenu>
                                <ContextMenu Opened="OnTranscriptMenuOpened">
                                    <MenuItem x:Name="ExcludeMenuItem" Header="{x:Static p:Strings.Meeting_Menu_Exclude}" Click="OnExcludeMenuClick" />
                                    <MenuItem x:Name="IncludeMenuItem" Header="{x:Static p:Strings.Meeting_Menu_Include}" Click="OnIncludeMenuClick" />
                                    <Separator />
                                    <MenuItem x:Name="FromHereMenuItem" Header="{x:Static p:Strings.Meeting_Menu_FromHere}" Click="OnFromHereMenuClick" />
                                    <MenuItem x:Name="ToHereMenuItem" Header="{x:Static p:Strings.Meeting_Menu_ToHere}" Click="OnToHereMenuClick" />
                                    <Separator />
                                    <MenuItem x:Name="SpeakerMenuItem" Click="OnSpeakerMenuClick" />
                                    <Separator />
                                    <MenuItem x:Name="CopyRowsMenuItem" Header="{x:Static p:Strings.Meeting_Menu_Copy}" InputGestureText="Ctrl+C" Click="OnCopyRowsMenuClick" />
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3" Opacity="{Binding Opacity, Mode=OneTime}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" VerticalAlignment="Top" Margin="0,2,8,0" Focusable="False"
                                                  IsChecked="{Binding IsUsed, Mode=OneTime}" IsEnabled="{Binding CanToggle, Mode=OneTime}" Click="OnUseCheckClick"
                                                  AutomationProperties.Name="{x:Static p:Strings.Meeting_UseForMinutes}" ToolTip="{Binding CheckTip, Mode=OneTime}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Time, Mode=OneTime}" FontFamily="Consolas, Segoe UI" FontSize="12" Margin="0,2,8,0"
                                                   Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                                        <StackPanel Grid.Column="2">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Speaker, Mode=OneTime}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Reason, Mode=OneTime}" Visibility="{Binding ReasonVisibility, Mode=OneTime}" Margin="8,1,0,0" FontSize="11.5"
                                                           Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Text, Mode=OneTime}" TextWrapping="Wrap" FontSize="13.5" TextDecorations="{Binding Decorations, Mode=OneTime}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </TabItem>
                <!-- 要件: REQ-MTG-012 -->
                <!-- 設計判断: DEC-MTG-049 -->
                <TabItem Header="{x:Static p:Strings.Meeting_Tab_Highlights}">
                    <TextBox x:Name="HighlightsBox" AutomationProperties.Name="{x:Static p:Strings.Meeting_Highlights_A11y}" Style="{StaticResource Reader}" FontFamily="Consolas, Yu Gothic UI" />
                </TabItem>
                <TabItem Header="{x:Static p:Strings.Meeting_Tab_Notes}">
                    <DockPanel Margin="6">
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="{x:Static p:Strings.Save}" Click="OnSaveNotesClick" />
                            <Button x:Name="SaveNotesAndRegenerateButton" Content="{x:Static p:Strings.Meeting_SaveAndRegenerate}" Click="OnSaveNotesAndRegenerateClick" />
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Note}" Margin="0,0,0,4"
                                   Text="{x:Static p:Strings.Meeting_NotesHint}" />
                        <TextBox x:Name="NotesBox" AutomationProperties.Name="{x:Static p:Strings.Meeting_Notes_A11y}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="4,3"
                                 FontFamily="Consolas, Yu Gothic UI" />
                    </DockPanel>
                </TabItem>
            </TabControl>
        </DockPanel>
    </Grid>
</Window>

<Project Sdk="Microsoft.NET.Sdk">

  <!-- タスクトレイに常駐する Windows 版 Hanasu 本体（WPF）。
       10.0.19041.0 は Windows.Media.SpeechRecognition（WinRT）を使うため -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <!-- タスクトレイのアイコン（NotifyIcon）だけ WinForms を使う -->
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Hanasu.Windows</RootNamespace>
    <AssemblyName>Hanasu</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Hanasu.ico</ApplicationIcon>
    <!-- 配布のコマンドは windows/README.md の「配布」を参照 -->
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType Condition="'$(Configuration)' == 'Release'">embedded</DebugType>
    <!-- LibraryImport（P/Invoke のソース生成）に要る -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- WFAC010 は WinForms のアプリ向けの警告。WPF は manifest で DPI を決めるのが推奨なので抑える -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <!-- 要件: REQ-COM-060 -->
    <!-- UI の文字列のニュートラルの言語（Properties/Strings.resx）は英語。ほかの言語はサテライトアセンブリ（<カルチャ>/Hanasu.resources.dll） -->
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF と WinForms の両方を使うと Application などの名前がぶつかるので、WinForms の既定の using は外す -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <!-- 画面の文字列（Properties/Strings.resx から作る Strings） -->
    <Using Include="Hanasu.Windows.Properties" />
    <!-- アプリと hanasu コマンドで共有する Windows の部品（AppLog・DPAPI・Windows Hello など。DEC-COM-193） -->
    <Using Include="Hanasu.Platform" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hanasu.Core\Hanasu.Core.csproj" />
    <ProjectReference Include="..\Hanasu.Platform\Hanasu.Platform.csproj" />
    <ProjectReference Include="..\Hanasu.Whisper\Hanasu.Whisper.csproj" />
    <ProjectReference Include="..\Hanasu.Diarization\Hanasu.Diarization.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <!-- 要件: REQ-COM-194 -->
    <!-- 動いている Claude Desktop の起動の引数（Win32_Process.CommandLine）を読む（Services/AgentApps.cs。設計判断: DEC-COM-202） -->
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Hanasu.ico" />
  </ItemGroup>

  <!-- 要件: REQ-COM-060 -->
  <!-- 画面の文字列。Strings.resx は英語、Strings.<カルチャ>.resx が各言語。ビルドのときに Hanasu.Windows.Properties.Strings を作り、
       XAML からは {x:Static p:Strings.名前}、コードからは Strings.名前 で読む。訳の出し入れは scripts/i18n-resx.py -->
  <ItemGroup>
    <EmbeddedResource Update="Properties\Strings.resx">
      <StronglyTypedFileName>$(IntermediateOutputPath)Strings.Designer.cs</StronglyTypedFileName>
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>Hanasu.Windows.Properties</StronglyTypedNamespace>
      <StronglyTypedClassName>Strings</StronglyTypedClassName>
      <PublicClass>true</PublicClass>
    </EmbeddedResource>
  </ItemGroup>
  <Target Name="HanasuStringsForMarkup" BeforeTargets="GenerateTemporaryTargetAssembly" DependsOnTargets="PrepareResourceNames;ResGen">
    <ItemGroup>
      <_GeneratedCodeFiles Include="$(IntermediateOutputPath)Strings.Designer.cs" />
    </ItemGroup>
  </Target>

  <!-- 要件: REQ-REL-005 -->
  <!-- 配布物（publish のフォルダ）に、Hanasu のライセンスと第三者のライセンスの表示を入れる。
       .NET ランタイムの第三者の表示は、ProtectedData のパッケージに入っている dotnet/runtime のものを使う -->
  <ItemGroup>
    <None Include="..\..\LICENSE" Link="LICENSE.txt" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Include="..\..\LICENSE-ADDITIONAL-PERMISSION.md" Link="LICENSE-ADDITIONAL-PERMISSION.md" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Include="..\..\NOTICE" Link="NOTICE.txt" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Include="..\THIRD_PARTY_NOTICES.md" Link="THIRD_PARTY_NOTICES.md" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Include="$(NuGetPackageRoot)system.security.cryptography.protecteddata/8.0.0/THIRD-PARTY-NOTICES.TXT" Link="dotnet-THIRD-PARTY-NOTICES.txt" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <!-- Whisper.net.Runtime はすべての OS のネイティブライブラリを runtimes/ に置くので、配布物には publish した RID（win-x64 など）の分だけを入れる。
       ネイティブライブラリは exe に入れず、exe の隣の runtimes/win-*/ に置く（Whisper.net がそこから読むため） -->
  <Target Name="DropNonWindowsWhisperRuntimes" AfterTargets="ComputeResolvedFilesToPublishList">
    <PropertyGroup>
      <!-- RID を指定して publish したときはその RID のものだけ、指定しないときは Windows 用をすべて残す -->
      <_HanasuRuntimeDir Condition="'$(RuntimeIdentifier)' != ''">runtimes/$(RuntimeIdentifier)/</_HanasuRuntimeDir>
      <_HanasuRuntimeDir Condition="'$(RuntimeIdentifier)' == ''">runtimes/win-</_HanasuRuntimeDir>
    </PropertyGroup>
    <ItemGroup>
      <_HanasuForeignRuntime Include="@(ResolvedFileToPublish)"
          Condition="$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').Replace('\','/').StartsWith('runtimes/')) And !$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').Replace('\','/').StartsWith('$(_HanasuRuntimeDir)'))" />
      <ResolvedFileToPublish Remove="@(_HanasuForeignRuntime)" />
      <!-- macOS の Metal 用のシェーダーも要らない -->
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.metal'" />
      <!-- 話者分離（sherpa-onnx）のネイティブライブラリも exe に入れず、exe の隣に置く。
           exe に入れると一時フォルダに展開して読むことになり、Windows 11 の System32 にある別の版の onnxruntime.dll と取り違えるおそれがあるため -->
      <ResolvedFileToPublish Update="@(ResolvedFileToPublish)" Condition="'%(Filename)' == 'sherpa-onnx-c-api' Or '%(Filename)' == 'onnxruntime'">
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
      <!-- Whisper のネイティブライブラリは exe に入れず、ファイルのまま置く -->
      <ResolvedFileToPublish Update="@(ResolvedFileToPublish)" Condition="$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').Replace('\','/').StartsWith('runtimes/win-'))">
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
